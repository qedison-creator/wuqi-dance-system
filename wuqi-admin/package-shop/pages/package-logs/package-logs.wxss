.package-logs-page {
  padding: 20rpx 28rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.filter-bar {
  margin-bottom: 20rpx;
}

.page-header {
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-title {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: bold;
}
.hf-store {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx 8rpx 14rpx;
  background: rgba(255,255,255,0.7);
  border: 1rpx solid rgba(185,130,100,0.2);
  border-radius: 28rpx;
}

.hf-store:active {
  background: rgba(212,120,110,0.08);
}

.hfs-icon {
  font-size: 22rpx;
  color: #D4786E;
  margin-right: 6rpx;
}

.hfs-label {
  font-size: 21rpx;
  color: #6B5D56;
  font-weight: 500;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 4rpx;
}

.hfs-arrow {
  font-size: 18rpx;
  color: #C4B3A4;
}

/* 门店选择弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(44,36,22,0.45);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100000;
}

.store-modal {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 56rpx 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(42,33,34,0.12);
}

.stm-hd {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.stm-title {
  font-size: 34rpx;
  color: #2C2416;
  font-weight: 700;
  text-align: center;
}

.stm-list {
  margin-bottom: 28rpx;
}

.stm-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 20rpx;
  background: #F9F7F5;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid transparent;
  transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);
}

.stm-item:last-child {
  margin-bottom: 0;
}

.stm-item:active {
  transform: scale(0.98);
}

.stm-active {
  background: #FDF2EF;
  border-color: #D4786E;
}

.stm-name {
  font-size: 28rpx;
  color: #2C2416;
  font-weight: 500;
}

.stm-active .stm-name {
  color: #D4786E;
  font-weight: 700;
}

.stm-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4786E, #C05D53);
  position: relative;
}

.stm-check::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -60%) rotate(45deg);
  width: 10rpx;
  height: 18rpx;
  border-bottom: 3rpx solid #FFFFFF;
  border-right: 3rpx solid #FFFFFF;
}

.stm-bottom {
  display: block;
}

.stm-close-btn {
  width: 100%;
  padding: 22rpx 0;
  background: #F9F7F5;
  border-radius: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6B5D5E;
  font-weight: 500;
}

.stm-close-btn:active {
  opacity: 0.7;
}

.filter-item {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
}

.filter-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.filter-value {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.tab-bar {
  display: flex;
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  color: var(--text-secondary);
  transition: all var(--transition-normal);
}

.tab-item.active {
  background: var(--color-primary);
  color: var(--text-inverse);
  font-weight: bold;
}

.tab-content {
  min-height: 400rpx;
}

.page-header {
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: bold;
}

.logs-list {
  display: flex;
  flex-direction: column;
}

.log-item {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.log-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.log-title {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: bold;
}

.log-title-wrap {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
}

.deleted-tag {
  font-size: 20rpx;
  color: #FFFFFF;
  background: #B5A5A5;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 8rpx;
  font-weight: normal;
}

/* 会员记录数量徽标 */
.record-count-badge {
  font-size: 20rpx;
  color: var(--color-primary, #D4786E);
  background: var(--color-primary-bg, rgba(212,120,110,0.1));
  border-radius: 20rpx;
  padding: 2rpx 12rpx;
  margin-left: 8rpx;
  font-weight: 500;
}

.log-nick {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: normal;
}

.log-type {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background-color: var(--color-success-bg);
  color: var(--color-success);
}

/* 状态标签颜色 */
.status-active {
  background: var(--color-success-bg);
  color: var(--color-success);
}

.status-pending {
  background: var(--color-warning-bg);
  color: var(--color-warning);
}

.status-expired, .status-exhausted {
  background: var(--color-error-bg);
  color: var(--color-error);
}

.log-body {
  padding-top: 8rpx;
  border-top: 1rpx solid var(--border);
}

/* 子记录容器 */
.sub-record {
  padding: 4rpx 0;
}

/* 子记录分隔线 */
.sub-record-divider {
  height: 1rpx;
  background: var(--border, rgba(0,0,0,0.06));
  margin: 16rpx 0;
}

/* 子记录头部（记录类型标签） */
.sub-record-header {
  margin-bottom: 12rpx;
}

.log-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.log-row:last-child {
  margin-bottom: 0;
}

.log-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.log-value {
  font-size: 26rpx;
  color: var(--text-primary);
}

.log-value.highlight {
  color: var(--color-primary);
  font-weight: bold;
}

.loading {
  padding: 60rpx 0;
  text-align: center;
}

.load-more {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 查看更多按钮（卡片样式，跟随列表流动） */
.expand-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  margin: 20rpx 0 0;
  font-size: 26rpx;
  color: var(--color-primary, #D4786E);
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(61,44,46,0.04);
}

.expand-toggle:active {
  opacity: 0.7;
}

.expand-toggle text {
  margin-right: 10rpx;
}

.toggle-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid var(--color-primary, #D4786E);
  margin-left: 8rpx;
  margin-top: 4rpx;
}

.toggle-arrow.down {
  border-top: 12rpx solid var(--color-primary, #D4786E);
  border-bottom: none;
}

/* 返回顶部按钮 */
.back-to-top {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(61,44,46,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.3s ease;
}

.back-to-top.show {
  opacity: 1;
  transform: translateY(0);
}

.btt-icon {
  font-size: 36rpx;
  color: var(--color-primary, #D4786E);
  font-weight: 600;
  line-height: 1;
}

/* 搜索条 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.search-box {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 280rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx 8rpx 8rpx 20rpx;
  border: 1rpx solid rgba(185,130,100,0.15);
  box-shadow: 0 2rpx 8rpx rgba(61,44,46,0.04);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
  height: 56rpx;
  line-height: 56rpx;
}

.search-btn {
  font-size: 24rpx;
  color: #FFFFFF;
  background: var(--color-primary, #D4786E);
  border-radius: 18rpx;
  padding: 8rpx 18rpx;
  margin-left: 8rpx;
}

.search-btn:active {
  opacity: 0.7;
}

.search-clear {
  font-size: 28rpx;
  color: var(--text-tertiary);
  padding: 8rpx 12rpx;
  margin-left: 4rpx;
}

.search-clear:active {
  color: var(--text-secondary);
}

/* 套餐变更记录标签（蓝色风格） */
.log-type.log-type-change {
  background-color: rgba(48, 102, 220, 0.1);
  color: #3066DC;
}

/* 变更明细列表 */
.change-detail {
  background: #F6F8FB;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin: 8rpx 0;
  border-left: 4rpx solid #3066DC;
}

.change-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.change-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.change-values {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.change-old {
  font-size: 24rpx;
  color: #B5A5A5;
  text-decoration: line-through;
}

.change-arrow {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.change-new {
  font-size: 24rpx;
  color: #3066DC;
  font-weight: 600;
}