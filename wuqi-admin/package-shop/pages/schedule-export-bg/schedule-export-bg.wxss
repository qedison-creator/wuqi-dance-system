.container {
  min-height: 100vh;
  background: #F8F7F5;
  padding: 24rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.active-card {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.08);
}

.active-preview {
  width: 100%;
  height: 480rpx;
  background: #EEE;
  display: block;
}

.active-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: #E8785A;
  color: #FFF;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.upload-area {
  background: #FFF;
  border: 2rpx dashed #D5CCC4;
  border-radius: 20rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.upload-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(232,120,90,0.1);
  color: #E8785A;
  font-size: 48rpx;
  line-height: 72rpx;
  text-align: center;
  font-weight: 300;
}

.upload-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.upload-hint {
  font-size: 22rpx;
  color: #999;
}

.bg-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.bg-item {
  width: calc(50% - 8rpx);
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  background: #EEE;
}

.bg-preview {
  width: 100%;
  height: 100%;
  display: block;
}

.bg-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0,0,0,0.6));
  padding: 20rpx 16rpx 16rpx;
}

.bg-actions {
  display: flex;
  gap: 12rpx;
}

.bg-btn {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  padding: 10rpx 0;
  border-radius: 8rpx;
  font-weight: 500;
}

.bg-btn-normal {
  background: rgba(255,255,255,0.9);
  color: #1A1A1A;
}

.bg-btn-active {
  background: #E8785A;
  color: #FFF;
}

.bg-btn-delete {
  background: rgba(255,255,255,0.2);
  color: #FFF;
  border: 1rpx solid rgba(255,255,255,0.5);
}

.empty-state {
  text-align: center;
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  font-weight: 500;
}

.empty-hint {
  font-size: 24rpx;
  color: #CCC;
}
