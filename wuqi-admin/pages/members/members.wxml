<view class="page {{showPackageModal || showReviewModal ? 'page-scroll-disabled' : ''}}">
  <!-- 顶部固定区域：门店筛选 + 统计 + 搜索 + 筛选标签 -->
  <view class="sticky-header">
    <view class="store-switcher-bar" wx:if="{{showStoreSwitcher}}" bindtap="onStoreSwitcherTap">
      <view class="store-switcher-inner">
        <image class="store-switcher-icon" src="/images/icons/shop-store.svg" mode="aspectFit" decoding="async"></image>
        <text class="store-switcher-name">{{currentStoreName}}</text>
        <image class="store-switcher-arrow" src="/images/icons/chevron-right.svg" mode="aspectFit" decoding="async"></image>
      </view>
    </view>

    <view class="stats-section">
      <view class="stats-chips">
        <view class="stats-chip stats-chip-info" bindtap="onGoInfoReview">
          <text class="stats-chip-val">{{infoChangeCount || 0}}</text>
          <text class="stats-chip-label">会员信息修改请求</text>
        </view>
        <view class="stats-chip stats-chip-warning" bindtap="onGoReview">
          <text class="stats-chip-val">{{pendingCount || 0}}</text>
          <text class="stats-chip-label">待审核用户</text>
        </view>
        <view class="stats-chip stats-chip-premember" bindtap="onGoPreMember">
          <text class="stats-chip-val">{{pendingClaimCount || 0}}</text>
          <text class="stats-chip-label">预建档会员</text>
        </view>
      </view>
    </view>

    <view class="search-section">
      <view class="search-input-wrap">
        <text class="search-icon">🔍</text>
        <input class="search-input" placeholder="搜索会员姓名/手机号" value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" />
        <view class="search-btn" wx:if="{{keyword}}" catchtap="onSearch">搜索</view>
        <view class="search-clear" wx:if="{{keyword}}" catchtap="onClearSearch">✕</view>
      </view>
    </view>

    <scroll-view class="filter-bar" scroll-x enhanced show-scrollbar="{{false}}" enable-flex>
      <view class="filter-item {{activeFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="onFilterChange">
        <text>全部</text>
      </view>
      <view class="filter-item {{activeFilter === 'no-package' ? 'active' : ''}}" data-filter="no-package" bindtap="onFilterChange">
        <text>未录套餐</text>
      </view>
      <view class="filter-item {{activeFilter === 'active' ? 'active' : ''}}" data-filter="active" bindtap="onFilterChange">
        <text>使用中</text>
      </view>
      <view class="filter-item {{activeFilter === 'cross_store' ? 'active' : ''}}" data-filter="cross_store" bindtap="onFilterChange">
        <text>跨门店</text>
      </view>
      <view class="filter-item {{activeFilter === 'unactivated' ? 'active' : ''}}" data-filter="unactivated" bindtap="onFilterChange">
        <text>待激活</text>
      </view>
      <view class="filter-item {{activeFilter === 'suspended' ? 'active' : ''}}" data-filter="suspended" bindtap="onFilterChange">
        <text>已停卡</text>
      </view>
      <view class="filter-item {{activeFilter === 'expired' ? 'active' : ''}}" data-filter="expired" bindtap="onFilterChange">
        <text>已过期</text>
      </view>
      <view class="filter-item {{activeFilter === 'exhausted' ? 'active' : ''}}" data-filter="exhausted" bindtap="onFilterChange">
        <text>已用完</text>
      </view>
    </scroll-view>
  </view>

  <view class="member-list" wx:if="{{!loading && members.length > 0}}">
    <view class="member-card" wx:for="{{members}}" wx:key="_id" wx:if="{{index < visibleCount}}" data-member="{{item}}" bindtap="onViewDetail">
      <view class="member-card-top">
          <image class="member-avatar" src="{{item.avatar || '/images/default-avatar.svg'}}" mode="aspectFill" binderror="onAvatarError" data-index="{{index}}" decoding="async"></image>
          <view class="member-info">
            <view class="member-name-row">
              <text class="member-name">{{item.real_name || item.nickname || '未知'}}</text>
              <view class="member-tags">
                <!-- 跨门店标签 -->
                <view class="cross-store-tag" wx:if="{{item.cross_store_access}}">
                  <text>跨门店</text>
                </view>
                <!-- 门店标签：福永店蓝色系，其他门店棕色系 -->
                <view class="store-tag {{store.isFuyong ? 'store-tag-fuyong' : ''}}" wx:for="{{item.store_labels}}" wx:key="id" wx:for-item="store">
                  <text class="store-tag-text">{{store.name}}</text>
                </view>
                <!-- 状态标签：仅显示会员级状态（待审核/未录套餐/已停卡）；套餐级状态（已激活/待激活/已过期/已用完）改为在下方套餐行内逐个标注 -->
                <view class="member-status {{item.status === 'pending' ? 'status-warning' : item.status === 'disabled' ? 'status-danger' : 'status-default'}}" wx:if="{{item.status === 'pending' || item.status === 'no-package' || item.status === 'disabled'}}">
                  <text>{{item.status === 'pending' ? '待审核' : item.status === 'no-package' ? '未录套餐' : '已停卡'}}</text>
                </view>
              </view>
            </view>
            <view class="member-phone-line">
              <text class="phone-item"><text class="phone-label">预留</text>{{(item._showPhone && !isReviewer) ? (item.reserve_phone_raw || '未录入') : (item.reserve_phone || '未录入')}}</text>
              <text class="phone-item" wx:if="{{item.wechat_phone_display}}"><text class="phone-label">微信</text>{{(item._showPhone && !isReviewer) ? (item.wechat_phone_raw || '') : item.wechat_phone_display}}</text>
              <view class="phone-eye-btn" wx:if="{{!isReviewer}}" catchtouchstart="onTogglePhone" data-index="{{index}}">
                <image class="phone-eye-icon" src="{{item._showPhone ? '/images/icons/eye-close.svg' : '/images/icons/eye-open.svg'}}" mode="aspectFit" decoding="async" />
              </view>
            </view>
            <!-- 未录入套餐的显示审核通过日期 -->
            <text class="review-date" wx:if="{{!item.has_package && item.reviewed_at}}">{{item.reviewed_at}}</text>
          </view>
        </view>
        <!-- 套餐区：一个套餐一行，行尾标注该套餐的激活状态 -->
        <view class="member-card-bottom" wx:if="{{item.package_rows && item.package_rows.length > 0}}">
          <view class="package-row {{pkgIdx < item.package_rows.length - 1 ? 'package-row-divider' : ''}}" wx:for="{{item.package_rows}}" wx:key="key" wx:for-item="pkg" wx:for-index="pkgIdx">
            <view class="package-row-info">
              <text class="meta-text">{{pkg.info}}</text>
              <text class="package-row-dance" wx:if="{{pkg.dance_style_text}}">舞种限制：{{pkg.dance_style_text}}</text>
            </view>
            <view class="member-status package-row-status {{pkg.status_cls}}">
              <text>{{pkg.status_text}}</text>
            </view>
          </view>
        </view>
        <view class="member-actions">
          <view class="member-action-btn member-action-contact" wx:if="{{!item.has_package}}" catchtap="onAddPackage" data-member="{{item}}">
            <text class="member-action-text">录入套餐</text>
          </view>
          <view class="member-action-hint" wx:else>
            <text class="member-action-hint-text">点击卡片查看详情</text>
            <text class="member-action-hint-arrow">›</text>
          </view>
        </view>
    </view>
    <!-- 查看更多按钮（在列表内部，跟随内容流动） -->
    <view class="expand-toggle {{loadingMore ? 'expand-toggle-loading' : ''}}" wx:if="{{!loading && hasMore}}" bindtap="onLoadMore">
      <text wx:if="{{!loadingMore}}">查看更多 ({{currentTotal - visibleCount}}位)</text>
      <text wx:else>加载中...</text>
      <view class="toggle-arrow down" wx:if="{{!loadingMore}}"></view>
    </view>
    <!-- 没有更多数据提示 -->
    <view class="no-more" wx:if="{{!hasMore && !loading && currentTotal > 0}}">
      <text class="no-more-text">没有更多数据了</text>
    </view>
  </view>

  <view class="loading-area" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view class="empty-state" wx:if="{{!loading && members.length === 0}}">
    <text class="empty-icon">👥</text>
    <text class="empty-text">暂无会员数据</text>
    <text class="empty-hint">下拉刷新或切换筛选条件试试</text>
  </view>

  <!-- 返回顶部按钮 -->
  <view class="back-to-top {{showBackToTop ? 'show' : ''}}" wx:if="{{showBackToTop}}" bindtap="onBackToTop">
    <text class="btt-icon">↑</text>
  </view>

  <!-- 审核弹窗 -->
  <view class="modal-mask" wx:if="{{showReviewModal}}" bindtap="onCloseReviewModal">
    <view class="review-modal-content" catchtap="onModalTap">
      <view class="modal-header">
        <text class="modal-title">审核会员</text>
        <text class="modal-close" bindtap="onCloseReviewModal">✕</text>
      </view>
      <view class="review-options">
        <view class="review-option {{reviewAction === 'approve' ? 'active' : ''}}" data-action="approve" bindtap="onReviewAction">
          <text class="review-option-text">通过</text>
        </view>
        <view class="review-option {{reviewAction === 'reject' ? 'active' : ''}}" data-action="reject" bindtap="onReviewAction">
          <text class="review-option-text">拒绝</text>
        </view>
      </view>
      <button class="btn-primary submit-btn" bindtap="onSubmitReview">确认</button>
    </view>
  </view>

  <!-- 套餐弹窗 -->
  <view class="modal-mask" wx:if="{{showPackageModal}}" bindtap="onClosePackageModal">
    <view class="package-modal-content" catchtap="onPackageModalTap">
      <view class="modal-header">
        <text class="modal-title">{{packageMember && packageMember.has_package ? '编辑套餐' : '新增套餐'}}</text>
        <text class="modal-close" bindtap="onClosePackageModal">✕</text>
      </view>

      <view class="form-group">
        <text class="form-label">所属门店 *</text>
        <picker mode="selector" range="{{storeListForPicker}}" range-key="name" value="{{packageFormStoreIndex}}" bindchange="onPackageStoreChange" disabled="{{packageStoreLocked}}">
          <view class="picker-field {{packageStoreLocked ? 'picker-field-locked' : ''}}">
            <text class="picker-text">{{packageForm.store_name || '请选择门店'}}</text>
            <text class="picker-arrow" wx:if="{{!packageStoreLocked}}">▼</text>
          </view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">套餐类型 *</text>
        <view class="package-type-selector">
          <view class="type-option {{packageForm.package_type === 'count_card' ? 'active' : ''}}" data-type="count_card" bindtap="onPackageTypeChange">
            <text>次卡</text>
          </view>
          <view class="type-option {{packageForm.package_type === 'time_card' ? 'active' : ''}}" data-type="time_card" bindtap="onPackageTypeChange">
            <text>时间卡</text>
          </view>
        </view>
      </view>

      <view class="form-group" wx:if="{{packageForm.package_type === 'count_card'}}">
        <text class="form-label">次数 *</text>
        <input class="input-field" type="number" placeholder="请输入次数" value="{{packageForm.total_credits}}" data-field="total_credits" bindinput="onPackageInput" />
      </view>

      <view class="form-group">
        <text class="form-label">服务有效期 *</text>
        <view class="duration-input-row">
          <input class="input-field duration-input" type="number" placeholder="请输入时长" value="{{packageForm.duration_value}}" data-field="duration_value" bindinput="onPackageInput" />
          <view class="duration-unit-selector">
            <view class="unit-option {{packageForm.duration_unit === 'month' ? 'active' : ''}}" data-unit="month" bindtap="onPackageDurationUnitChange">
              <text>月</text>
            </view>
            <view class="unit-option {{packageForm.duration_unit === 'day' ? 'active' : ''}}" data-unit="day" bindtap="onPackageDurationUnitChange">
              <text>天</text>
            </view>
          </view>
        </view>
      </view>

      <view class="form-group" wx:if="{{packageForm.package_type === 'time_card'}}">
        <text class="form-label">次数限制 *</text>
        <view class="package-type-selector">
          <view class="type-option {{packageForm.limit_type === 'limited' ? 'active' : ''}}" data-type="limited" bindtap="onPackageLimitTypeChange">
            <text>限制次数</text>
          </view>
          <view class="type-option {{packageForm.limit_type === 'unlimited' ? 'active' : ''}}" data-type="unlimited" bindtap="onPackageLimitTypeChange">
            <text>不限</text>
          </view>
        </view>
      </view>

      <view class="form-group" wx:if="{{packageForm.package_type === 'time_card' && packageForm.limit_type === 'limited'}}">
        <text class="form-label">周期类型 *</text>
        <view class="package-type-selector">
          <view class="type-option {{packageForm.limit_cycle === 'daily' ? 'active' : ''}}" data-type="daily" bindtap="onPackageLimitCycleChange">
            <text>每日</text>
          </view>
          <view class="type-option {{packageForm.limit_cycle === 'weekly' ? 'active' : ''}}" data-type="weekly" bindtap="onPackageLimitCycleChange">
            <text>每周</text>
          </view>
          <view class="type-option {{packageForm.limit_cycle === 'monthly' ? 'active' : ''}}" data-type="monthly" bindtap="onPackageLimitCycleChange">
            <text>每月</text>
          </view>
        </view>
      </view>

      <view class="form-group" wx:if="{{packageForm.package_type === 'time_card' && packageForm.limit_type === 'limited'}}">
        <text class="form-label">限制次数 *</text>
        <input class="input-field" type="number" placeholder="请输入限制次数" value="{{packageForm.limit_value}}" data-field="limit_value" bindinput="onPackageInput" />
      </view>

      <view class="form-group">
        <text class="form-label">能参与的舞种课程</text>
        <view class="dance-style-picker" bindtap="onOpenDanceStylePicker">
          <text class="dance-style-picker-text {{packageForm.dance_style_limit.length > 0 ? 'has-value' : ''}}">{{packageFormDanceStyleText || '不限舞种'}}</text>
          <text class="dance-style-picker-arrow">›</text>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">备注</text>
        <input class="input-field" placeholder="选填" value="{{packageForm.remark}}" data-field="remark" bindinput="onPackageInput" />
      </view>

      <button class="btn-primary submit-btn" bindtap="onSubmitPackage">确认录入</button>
    </view>
  </view>
</view>

<!-- 舞种限制单选弹窗（门店选择器风格） -->
<view class="modal-mask" wx:if="{{showDanceStylePicker}}" bindtap="onCloseDanceStylePicker">
  <view class="store-picker-modal" catchtap="onModalTap">
    <view class="spm-header">
      <text class="spm-title">能参与的舞种课程</text>
      <text class="spm-close" bindtap="onCloseDanceStylePicker">×</text>
    </view>
    <scroll-view class="spm-list" scroll-y enhanced show-scrollbar="{{false}}">
      <!-- 不限舞种选项（默认选中） -->
      <view class="spm-item {{selectedDanceStyleId === '' ? 'spm-active' : ''}}" data-id="" bindtap="onSelectDanceStyle">
        <text class="spm-name">不限舞种</text>
      </view>
      <!-- 舞种列表 -->
      <view class="spm-item {{selectedDanceStyleId === dsItem._id ? 'spm-active' : ''}}"
            wx:for="{{danceStyleList}}" wx:key="_id" wx:for-item="dsItem"
            data-id="{{dsItem._id}}" bindtap="onSelectDanceStyle">
        <text class="spm-name">{{dsItem.name}}</text>
      </view>
      <view class="spm-empty" wx:if="{{danceStyleList.length === 0}}">暂无舞种，请先在店务管理-舞种管理中创建</view>
    </scroll-view>
  </view>
</view>
<update-modal />
