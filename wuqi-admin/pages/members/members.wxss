.page {
  padding: 0;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background-color: #F6F3F0;
  min-height: 100vh;
  max-width: 750rpx;
  margin: 0 auto;
  box-sizing: border-box;
}

.page-scroll-disabled {
  position: fixed;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.sticky-header {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 10;
  background: #FAF8F5;
}

.header-chip-wrap {
  position: relative;
  display: flex;
  align-items: center;
  margin-right: 16rpx;
}

.header-chip {
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  transition: all 0.2s ease;
}

.header-chip:active {
  transform: scale(0.95);
}

.header-chip-review {
  background: rgba(91, 140, 90, 0.08);
  border: 1rpx solid rgba(91, 140, 90, 0.2);
}

.header-chip-info {
  background: rgba(82, 125, 170, 0.08);
  border: 1rpx solid rgba(82, 125, 170, 0.2);
}

.header-chip-info .header-chip-text {
  color: #527DAA;
}

.header-chip-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #5B8C5A;
}

.review-badge {
  position: absolute;
  top: -10rpx;
  right: -14rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: #C44B4B;
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: 32rpx;
  padding: 0 8rpx;
  z-index: 10;
  pointer-events: none;
  box-shadow: 0 2rpx 8rpx rgba(196, 75, 75, 0.25);
}

.header-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8E2D8;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 8rpx rgba(139, 126, 106, 0.06);
  margin-left: 12rpx;
}

.header-btn:active {
  background: #F0ECE6;
  transform: scale(0.92);
}

.header-btn-icon {
  font-size: 32rpx;
  color: #8B7E6A;
}

.search-header {
  padding: 0 28rpx;
  margin-bottom: 16rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #E8E2D8;
  border-radius: 32rpx;
  padding: 0 24rpx;
  height: 80rpx;
  transition: border-color 0.2s ease;
  box-shadow: 0 2rpx 10rpx rgba(139, 126, 106, 0.05);
}

.search-box:focus-within {
  border-color: #C5744B;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  color: #2C2416;
}

.search-input::placeholder {
  color: #B8AF9E;
}

.search-clear {
  font-size: 28rpx;
  color: #B8AF9E;
  padding: 10rpx;
  flex-shrink: 0;
}

.search-clear:active {
  color: #2C2416;
}

/* ===== 统一门店选择器 ===== */
.store-switcher-bar {
  margin: 16rpx 28rpx 4rpx;
}

.store-switcher-inner {
  display: flex;
  align-items: center;
  background: linear-gradient(145deg, #FFFFFF 0%, #FEF9F8 100%);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  border: 1rpx solid rgba(197, 116, 75, 0.15);
  box-shadow: 0 2rpx 12rpx rgba(44, 36, 22, 0.04);
  transition: background 150ms ease;
}

.store-switcher-inner:active {
  background: rgba(197, 116, 75, 0.04);
}

.store-switcher-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.store-switcher-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2416;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-switcher-arrow {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
  opacity: 0.3;
  transform: rotate(90deg);
}

.stats-section {
  padding: 0 28rpx;
  margin-bottom: 16rpx;
}

.stats-chips {
  display: flex;
  align-items: center;
}

.stats-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  background: #FFFFFF;
  border: 1rpx solid #E8E2D8;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(139, 126, 106, 0.06);
  transition: all 0.2s ease;
  margin-right: 16rpx;
}

.stats-chip:last-child {
  margin-right: 0;
}

.stats-chip:active {
  transform: scale(0.97);
}

.stats-chip-warning {
  border-color: rgba(196, 102, 62, 0.2);
  background: #FAEEE4;
}

.stats-chip-info {
  border-color: rgba(82, 125, 170, 0.2);
  background: rgba(82, 125, 170, 0.08);
}

.stats-chip-premember {
  border-color: rgba(196, 102, 62, 0.2);
  background: #FFF4E8;
}

.stats-chip-premember .stats-chip-val {
  color: #C4663E;
}

.stats-chip-val {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C2416;
  line-height: 1.2;
  margin-bottom: 6rpx;
}

.stats-chip-warning .stats-chip-val {
  color: #C4663E;
}

.stats-chip-info .stats-chip-val {
  color: #527DAA;
}

.stats-chip-label {
  font-size: 22rpx;
  color: #B8AF9E;
}

.search-section {
  margin: 0 28rpx 16rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E8E2D8;
  padding: 8rpx 8rpx 8rpx 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(139, 126, 106, 0.06);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: #B8AF9E;
}

.search-input {
  flex: 1;
  height: 56rpx;
  font-size: 26rpx;
  color: #2C2416;
  background: transparent;
}

.search-input::placeholder {
  color: #C4BFB4;
}

/* 搜索按钮（有输入时显示） */
.search-btn {
  font-size: 24rpx;
  color: #FFFFFF;
  background: var(--color-primary, #D4786E);
  border-radius: 18rpx;
  padding: 8rpx 18rpx;
  margin-left: 8rpx;
}

.search-btn:active {
  opacity: 0.7;
}

/* 清除按钮（有输入时显示） */
.search-clear {
  font-size: 28rpx;
  color: #8B7E6A;
  padding: 8rpx 12rpx;
  margin-left: 4rpx;
}

.search-clear:active {
  color: #6B5D4E;
}

.distribution-section {
  margin: 0 28rpx 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E8E2D8;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(139, 126, 106, 0.06);
}

.section-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  transition: background 0.2s ease;
}

.section-label:active {
  background: #F6F3F0;
}

.section-label-text {
  font-size: 28rpx;
  color: #2C2416;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.toggle-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: #F6F3F0;
  transition: all 0.2s ease;
}

.toggle-icon.expanded {
  background: #FAEEE4;
}

.toggle-arrow {
  font-size: 20rpx;
  color: #B8AF9E;
}

.toggle-icon.expanded .toggle-arrow {
  color: #C5744B;
}

.distribution-content {
  padding: 0 28rpx 28rpx;
}

.dist-summary {
  display: flex;
  margin-bottom: 20rpx;
}

.dist-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 20rpx 0;
  background: #F6F3F0;
  border-radius: 12rpx;
  border: 1rpx solid #E8E2D8;
  margin-right: 12rpx;
}

.dist-item:last-child {
  margin-right: 0;
}

.dist-val {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C2416;
  line-height: 1.2;
  margin-bottom: 4rpx;
}

.dist-active {
  color: #5B8C5A;
}

.dist-expired {
  color: #B8AF9E;
}

.dist-label {
  font-size: 22rpx;
  color: #B8AF9E;
}

.dist-cards-scroll {
  width: 100%;
}

.dist-cards {
  display: flex;
  padding: 4rpx 0;
}

.dist-card {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 130rpx;
  padding: 20rpx 16rpx;
  background: #F6F3F0;
  border-radius: 12rpx;
  border: 1rpx solid #E8E2D8;
  transition: all 0.2s ease;
  margin-right: 12rpx;
}

.dist-card:active {
  transform: scale(0.95);
}

.dist-card-active {
  border-color: #C5744B;
  background: #FAEEE4;
  box-shadow: 0 2rpx 12rpx rgba(197, 116, 75, 0.12);
}

.dist-card-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.dot-success {
  background: #5B8C5A;
  box-shadow: 0 0 8rpx rgba(91, 140, 90, 0.35);
}

.dot-warning {
  background: #C4663E;
  box-shadow: 0 0 8rpx rgba(196, 102, 62, 0.35);
}

.dot-danger {
  background: #C44B4B;
  box-shadow: 0 0 8rpx rgba(196, 75, 75, 0.35);
}

.dot-info {
  background: #C5744B;
  box-shadow: 0 0 8rpx rgba(197, 116, 75, 0.35);
}

.dot-muted {
  background: #B8AF9E;
  box-shadow: 0 0 8rpx rgba(184, 175, 158, 0.35);
}

.dot-outline {
  background: #E8E2D8;
  border: 2rpx solid #B8AF9E;
  box-sizing: border-box;
  box-shadow: none;
}

.dist-card-val {
  font-size: 32rpx;
  font-weight: 700;
  color: #2C2416;
  line-height: 1.2;
  margin-bottom: 4rpx;
}

.dist-card-active .dist-card-val {
  color: #C5744B;
}

.dist-card-label {
  font-size: 22rpx;
  color: #B8AF9E;
}

.filter-bar {
  display: flex;
  padding: 0 28rpx;
  margin-bottom: 24rpx;
  white-space: nowrap;
  height: 68rpx;
}

.filter-item {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8E2D8;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #8B7E6A;
  flex-shrink: 0;
  transition: all 0.2s ease;
  box-shadow: 0 1rpx 6rpx rgba(139, 126, 106, 0.04);
  margin-right: 12rpx;
}

.filter-item:last-child {
  margin-right: 0;
}

.filter-item:active {
  transform: scale(0.95);
}

.filter-item.active {
  background: #C5744B;
  border-color: #C5744B;
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(197, 116, 75, 0.25);
}

.filter-count {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 32rpx;
  margin-left: 8rpx;
  background: rgba(197, 116, 75, 0.12);
  color: #8B7E6A;
}

.filter-item.active .filter-count {
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
}

.member-list {
  padding: 0;
  display: flex;
  flex-direction: column;
}

.member-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E8E2D8;
  padding: 28rpx;
  margin: 0 28rpx 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(139, 126, 106, 0.06);
  transition: all 0.2s ease;
}

.member-card:active {
  transform: scale(0.98);
  background: #F6F3F0;
}

.member-card-top {
  display: flex;
  align-items: center;
}

.member-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 60rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  border: 2rpx solid #F0EBE4;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  margin-bottom: 6rpx;
}

.member-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2416;
  flex: 0 1 auto;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
  margin-top: 2rpx;
}

.member-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
  max-width: 100%;
  margin-left: auto;
}

.store-tag {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: rgba(197, 116, 75, 0.1);
  color: #C5744B;
  max-width: 100%;
  overflow: hidden;
}

/* 福永店门店标签：蓝色系（其他门店保持棕色系） */
.store-tag.store-tag-fuyong {
  background: rgba(72, 125, 232, 0.1);
  color: #487DE8;
}

/* 跨门店会员标签 */
.cross-store-tag {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: rgba(82, 196, 26, 0.1);
  color: #52C41A;
  border: 1rpx solid rgba(82, 196, 26, 0.3);
}

.store-tag-text {
  font-size: 22rpx;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.member-status {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.status-active {
  background: rgba(91, 140, 90, 0.1);
  color: #5B8C5A;
}

.status-warning {
  background: #FAEEE4;
  color: #C4663E;
}

.status-expired {
  background: rgba(184, 175, 158, 0.12);
  color: #B8AF9E;
}

.status-danger {
  background: rgba(196, 75, 75, 0.08);
  color: #C44B4B;
}

.status-default {
  background: rgba(184, 175, 158, 0.08);
  color: #8B7E6A;
}

.member-phone {
  font-size: 24rpx;
  color: #8B7E6A;
}

.member-phone-line {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  align-items: center;
}

.phone-item {
  font-size: 24rpx;
  color: #8B7E6A;
}

.phone-label {
  font-size: 22rpx;
  color: #B5A5A5;
  margin-right: 8rpx;
}

.phone-eye-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.phone-eye-btn:active {
  opacity: 0.6;
}

.phone-eye-icon {
  width: 36rpx;
  height: 36rpx;
}

.review-date {
  font-size: 22rpx;
  color: #B8AF9E;
  margin-top: 4rpx;
  display: block;
}

.member-card-bottom {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0EBE4;
}

/* 套餐行：一个套餐一行，行尾标注该套餐的激活状态 */
.package-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 6rpx 0;
}

.package-row-divider {
  border-bottom: 1rpx solid #F5F1EA;
}

.package-row-info {
  flex: 1;
  min-width: 0;
}

.package-row-info .meta-text {
  display: block;
  margin-right: 0;
  white-space: normal;
  line-height: 1.5;
}

.package-row-dance {
  display: block;
  font-size: 22rpx;
  color: #C5744B;
  margin-top: 4rpx;
}

.package-row-status {
  margin-left: auto;
}

.member-meta {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #8B7E6A;
  margin-right: 16rpx;
}

.meta-expire {
  color: #B8AF9E;
}

.member-stats {
  display: flex;
}

.stat-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-val {
  font-size: 28rpx;
  font-weight: 600;
  color: #2C2416;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #B8AF9E;
}

.member-actions {
  display: flex;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0EBE4;
}

.member-action-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F6F3F0;
  border: 1rpx solid #E8E2D8;
  border-radius: 36rpx;
  transition: all 0.2s ease;
}

.member-action-btn:last-child {
  margin-right: 0;
}

.member-action-hint {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
  padding: 4rpx 0;
}

.member-action-hint-text {
  font-size: 24rpx;
  color: #B8AF9E;
  font-weight: 400;
}

.member-action-hint-arrow {
  font-size: 32rpx;
  color: #C5744B;
  margin-left: 6rpx;
  line-height: 1;
  font-weight: 300;
}

.member-action-arrow {
  display: none;
  font-size: 28rpx;
  color: #B8AF9E;
  margin-left: 8rpx;
  font-weight: 400;
  line-height: 1;
}

.member-action-btn:only-child .member-action-arrow {
  color: #C5744B;
}

.member-action-btn:active {
  background: #F0ECE6;
  transform: scale(0.96);
}

.member-action-contact {
  background: #FAEEE4;
  border-color: rgba(197, 116, 75, 0.25);
}

.member-action-contact:active {
  background: rgba(197, 116, 75, 0.12);
}

.member-action-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #2C2416;
}

.member-action-contact .member-action-text {
  color: #C5744B;
}

.load-more {
  text-align: center;
  padding: 30rpx 0;
}

.load-more-text {
  font-size: 24rpx;
  color: #B8AF9E;
}

.loading-area {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #B8AF9E;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #2C2416;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #B8AF9E;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(44, 36, 22, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-close {
  font-size: 32rpx;
  color: #8B7E6A;
  padding: 10rpx;
}

.package-modal-content {
  width: 85%;
  max-height: 75vh;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  padding-bottom: 80rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.review-modal-content {
  width: 80%;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.modal-title {
  font-size: 32rpx;
  color: #2C2416;
  font-weight: 600;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #8B7E6A;
  margin-bottom: 12rpx;
}

.input-field {
  width: 100%;
  height: 80rpx;
  background: #F6F3F0;
  border: 2rpx solid #E8E2D8;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #2C2416;
  box-sizing: border-box;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  background: #F6F3F0;
  border: 2rpx solid #E8E2D8;
  border-radius: 14rpx;
  padding: 0 24rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #2C2416;
}

.picker-arrow {
  font-size: 24rpx;
  color: #B8AF9E;
}

.picker-field-locked {
  background: #F0EDE8;
  border-color: #E0DBD0;
}

.package-type-selector {
  display: flex;
  gap: 20rpx;
}

.type-option {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F6F3F0;
  border: 2rpx solid #E8E2D8;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #B8AF9E;
}

.type-option.active {
  background: #FAEEE4;
  border-color: #C5744B;
  color: #C5744B;
}

.duration-input-row {
  display: flex;
  gap: 16rpx;
}

.duration-input {
  flex: 1;
}

.duration-unit-selector {
  display: flex;
  gap: 12rpx;
}

.unit-option {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F6F3F0;
  border: 2rpx solid #E8E2D8;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #B8AF9E;
}

.unit-option.active {
  background: #FAEEE4;
  border-color: #C5744B;
  color: #C5744B;
}

/* 舞种限制开关列表 */
.extra-store-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.extra-store-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.extra-store-switch-row:last-child {
  border-bottom: none;
}

.extra-store-switch-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.extra-store-switch {
  transform: scale(0.85);
  transform-origin: right center;
}

/* 舞种限制下拉选择器 */
.dance-style-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.dance-style-picker-text {
  font-size: 28rpx;
  color: #999;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dance-style-picker-text.has-value {
  color: var(--text-primary);
}

.dance-style-picker-arrow {
  font-size: 36rpx;
  color: #CCC;
  margin-left: 16rpx;
}

/* 舞种限制单选弹窗（门店选择器风格） */
.store-picker-modal {
  width: 86%;
  max-width: 620rpx;
  max-height: 70vh;
  background: #FFFFFF;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.spm-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #F0EBE2;
  flex-shrink: 0;
  box-sizing: border-box;
}

.spm-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C2416;
}

.spm-close {
  font-size: 40rpx;
  color: #B8AF9E;
  padding: 4rpx 12rpx;
  line-height: 1;
}

.spm-list {
  flex: 1;
  max-height: 600rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.spm-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
  background: #F9F7F5;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.spm-item:last-child {
  margin-bottom: 0;
}

.spm-item:active {
  background: #F0EBE2;
}

.spm-active {
  background: #FDF2EF;
  border-color: #C4663E;
}

.spm-name {
  font-size: 28rpx;
  color: #2C2416;
  font-weight: 500;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 16rpx;
}

.spm-active .spm-name {
  color: #C4663E;
  font-weight: 600;
}

.spm-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #C4663E, #B05533);
  position: relative;
  flex-shrink: 0;
}

.spm-check::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -60%) rotate(45deg);
  width: 10rpx;
  height: 18rpx;
  border-bottom: 3rpx solid #FFFFFF;
  border-right: 3rpx solid #FFFFFF;
}

.spm-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #B8AF9E;
}

.extra-store-empty-tip {
  padding: 20rpx 0;
  font-size: 24rpx;
  color: var(--text-placeholder, #999);
  text-align: center;
}

.submit-btn {
  margin-top: 40rpx;
  width: 100%;
}

.btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #C5744B;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 600;
  border: none;
  text-align: center;
  padding: 0;
  box-shadow: 0 8rpx 24rpx rgba(197, 116, 75, 0.3);
}

.btn-primary::after {
  border: none;
}

.review-options {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.review-option {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F6F3F0;
  border: 2rpx solid #E8E2D8;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #8B7E6A;
}

.review-option.active {
  background: #FAEEE4;
  border-color: #C5744B;
  color: #C5744B;
}

.review-option-text {
  font-weight: 500;
}

/* 查看更多按钮（卡片样式，跟随列表流动） */
.expand-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  margin: 20rpx 28rpx 0;
  font-size: 26rpx;
  color: var(--color-primary, #D4786E);
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(61,44,46,0.04);
}

.expand-toggle:active {
  opacity: 0.7;
}

/* 加载中状态：禁用点击反馈，避免重复提交 */
.expand-toggle-loading {
  opacity: 0.6;
  pointer-events: none;
}

.expand-toggle text {
  margin-right: 10rpx;
}

.toggle-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid var(--color-primary, #D4786E);
  margin-left: 8rpx;
  margin-top: 4rpx;
}

.toggle-arrow.down {
  border-top: 12rpx solid var(--color-primary, #D4786E);
  border-bottom: none;
}

.no-more {
  padding: 30rpx 0;
  text-align: center;
}

.no-more-text {
  font-size: 24rpx;
  color: var(--text-tertiary, #999);
}

/* 返回顶部按钮 */
.back-to-top {
  position: fixed;
  right: 32rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(61,44,46,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.3s ease;
}

.back-to-top.show {
  opacity: 1;
  transform: translateY(0);
}

.btt-icon {
  font-size: 36rpx;
  color: var(--color-primary, #D4786E);
  font-weight: 600;
  line-height: 1;
}