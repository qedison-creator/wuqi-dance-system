.splash-container {
  width: 100%;
  height: 100vh;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

/* 皮肤品牌开场：方章 + 字标 + 原 logo */
.logo-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  min-height: 240rpx;
  justify-content: center;
  opacity: 0;
  transform: scale(0.9);
  transition: opacity 0.45s ease-out, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}

.logo-wrapper.logo-show {
  opacity: 1;
  transform: scale(1);
}

.sp-seal {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  font-weight: 700;
  font-family: 'Noto Serif SC', 'Songti SC', serif;
  border-radius: 16rpx;
  transform: rotate(-4deg);
  box-shadow: 4rpx 5rpx 0 rgba(0, 0, 0, 0.12);
}

.sp-seal {
  font-family: -apple-system, 'PingFang SC', sans-serif;
}

.skin-volt .sp-seal {
  transform: rotate(-6deg);
  border-radius: 20rpx;
}

.sp-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.sp-name {
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: 0.2em;
  margin-left: 0.2em; /* 平衡 letter-spacing */
}

.sp-en {
  font-size: 20rpx;
  letter-spacing: 0.4em;
  margin-left: 0.4em;
}

/* 原 logo：skin 模式下弱化为辅助行（保留品牌资产），classic 保持主视觉 */
.logo-img {
  width: 160rpx;
  height: 160rpx;
  opacity: 0.9;
}

.skin-classic .logo-img {
  width: 240rpx;
  height: 240rpx;
  opacity: 1;
}

.skin-classic .sp-seal,
.skin-classic .sp-brand {
  display: none;
}

/* paper/volt：使用皮肤字标系统，隐藏 classic 位图 logo（避免叠影） */
.skin-volt .logo-img,
.skin-paper .logo-img { display: none; }
