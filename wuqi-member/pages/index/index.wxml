<wxs src="../../utils/distance.wxs" module="fmt"/>
<page-meta page-style="{{(showAnnounceModal || showAnnouncePopup) ? 'overflow: hidden;' : ''}}"/>
<scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="{{false}}">
<view class="page skin-root skin-{{skinId}}">
  <!-- ===== 骨架屏 ===== -->
  <view class="sk-page" wx:if="{{loading}}">
    <view class="sk-banner"></view>
    <view class="sk-content">
      <view class="sk-hero-card">
        <view class="sk-greeting">
          <view class="sk-emoji"></view>
          <view class="sk-greet-main"></view>
          <view class="sk-greet-sub"></view>
        </view>
        <view class="sk-store">
          <view class="sk-store-inner">
            <view class="sk-store-icon"></view>
            <view class="sk-store-info">
              <view class="sk-store-name"></view>
              <view class="sk-store-addr"></view>
              <view class="sk-store-phone"></view>
            </view>
          </view>
        </view>
      </view>
      <view class="sk-announce"></view>
      <view class="sk-section">
        <view class="sk-section-header">
          <view class="sk-section-dot"></view>
          <view class="sk-section-title"></view>
        </view>
        <view class="sk-coach-row">
          <view class="sk-coach" wx:for="{{[1,2,3,4]}}" wx:key="*this">
            <view class="sk-coach-avatar"></view>
            <view class="sk-coach-name"></view>
          </view>
        </view>
      </view>
      <view class="sk-section">
        <view class="sk-section-header">
          <view class="sk-section-dot course"></view>
          <view class="sk-section-title"></view>
        </view>
        <view class="sk-course-row">
          <view class="sk-course-card" wx:for="{{[1,2]}}" wx:key="*this">
            <view class="sk-course-thumb"></view>
            <view class="sk-course-info">
              <view class="sk-course-tag"></view>
              <view class="sk-course-name"></view>
              <view class="sk-course-meta"></view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 真实内容 ===== -->
  <view wx:else>
  <block wx:if="{{skinId === 'classic'}}">
    <view class="banner-section" wx:if="{{banners.length > 0}}">
      <!-- 轮换间隔与切换方式由管理端配置：smooth 为原生平滑滑动；其余方式切换瞬时完成、由内容动画过渡 -->
      <swiper class="banner-swiper" indicator-dots="{{false}}" autoplay circular interval="{{bannerIntervalMs}}" easing-function="easeInOutCubic" duration="{{bannerMode === 'smooth' ? 600 : 0}}" bindchange="onBannerChange">
        <swiper-item wx:for="{{banners}}" wx:key="_id">
          <view class="banner-anim {{bannerCurrent === index ? 'banner-active anim-' + bannerMode : ''}}">
            <image class="banner-img" src="{{imageErrors['banner_'+item._id] ? '/images/default-course.svg' : item.image_url}}" binderror="onImgError" data-type="banner" data-id="{{item._id}}" mode="aspectFill" lazy-load decoding="async" />
          </view>
        </swiper-item>
      </swiper>
      <view class="banner-gradient"></view>
    </view>

    <view class="banner-placeholder" wx:if="{{banners.length === 0}}">
      <view class="bp-greeting">
        <text class="bp-emoji">{{greeting.emoji}}</text>
        <text class="bp-text">{{greeting.text}}</text>
      </view>
      <view class="bp-sub">{{greeting.sub}}</view>
    </view>

    <view class="content-section" style="padding-top: {{contentPaddingTop}}rpx;">
      <view class="hero-card">
        <view class="hc-greeting" wx:if="{{banners.length > 0}}">
          <text class="hc-greet-emoji">{{greeting.emoji}}</text>
          <view class="hc-greet-text">
            <text class="hc-greet-main">{{greeting.text}}</text>
            <text class="hc-greet-sub">{{greeting.sub}}</text>
          </view>
        </view>

        <view class="hc-store-wrap" wx:if="{{currentStore}}">
          <view class="hc-store-top">
            <view class="hc-store-name-row">
              <view class="hc-store-icon">
                <view class="hcs-icon-shape"></view>
              </view>
              <view class="hc-store-info">
                <view class="hc-store-name-wrap">
                  <text class="hc-store-name">{{currentStore.name}}</text>
                  <view class="hc-switch-btn" bindtap="onStoreTap">
                    <text>切换</text>
                    <view class="hcs-sw-arrow"></view>
                  </view>
                </view>
                <view class="hc-store-addr-wrap" bindtap="onNavTap" wx:if="{{currentStore.address}}">
                  <text class="hc-store-addr">{{currentStore.address}}</text>
                  <view class="hca-nav-icon"></view>
                </view>
                <view class="hc-store-phone-wrap" bindtap="onStoreCall" wx:if="{{currentStore.phone}}">
                  <text class="hc-store-phone">{{currentStore.phone}}</text>
                  <view class="hca-call-icon"></view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="hc-no-store" wx:else>
          <text class="hcn-text">暂未选择门店</text>
          <view class="hcn-btn" bindtap="onStoreTap">
            <text>选择门店</text>
          </view>
        </view>
      </view>

      <view class="announce-bar" wx:if="{{announces.length > 0}}" bindtap="onAnnounceTap">
        <view class="ab-dot"></view>
        <view class="ab-flip-wrap">
          <text class="ab-flip-text {{announceAnimPhase === 'out' ? 'anim-out' : ''}} {{announceAnimPhase === 'in' ? 'anim-in' : ''}}">{{announces[announceBarIndex].title || announces[announceBarIndex].content}}</text>
        </view>
        <view class="ab-badge" wx:if="{{hasMultipleAnnounces}}">
          <text>{{announces.length}}</text>
        </view>
      </view>

      <view class="section">
        <view class="section-header">
          <view class="section-title-wrap">
            <view class="section-dot"></view>
            <text class="section-title">舞栖教练</text>
          </view>
          <text class="section-more" bindtap="goCoachList">全部</text>
        </view>
        <scroll-view class="coach-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{hotCoaches.length > 0}}">
          <view class="coach-item" wx:for="{{hotCoaches}}" wx:key="_id" data-id="{{item._id}}" bindtap="onCoachTap">
            <view class="coach-avatar-wrap">
              <image class="coach-avatar" src="{{imageErrors['coach_'+item._id] ? '/images/default-avatar.svg' : (item.avatar_url || '/images/default-avatar.svg')}}" binderror="onImgError" data-type="coach" data-id="{{item._id}}" mode="aspectFill" lazy-load decoding="async" />
              <view class="coach-avatar-ring"></view>
            </view>
            <text class="coach-name">{{item.name}}</text>
          </view>
        </scroll-view>
        <view class="empty-inline" wx:else>
          <text class="eit">暂无教练信息</text>
        </view>
      </view>

      <view class="section">
        <view class="section-header">
          <view class="section-title-wrap">
            <view class="section-dot course-dot"></view>
            <text class="section-title">近期场次</text>
          </view>
        </view>
        <scroll-view class="course-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{recentCourses.length > 0}}">
          <view class="course-scroll-inner">
          <view class="course-card-h" wx:for="{{recentCourses}}" wx:key="_id" data-id="{{item._id}}" bindtap="onCourseTap">
            <image class="course-thumb" src="{{imageErrors['course_'+item._id] ? '/images/default-course.svg' : (item.cover || '/images/default-course.svg')}}" binderror="onImgError" data-type="course" data-id="{{item._id}}" mode="aspectFill" lazy-load />
            <view class="course-info-h">
              <view class="cih-tag" wx:if="{{item.danceStyleName}}" style="background: {{item.danceTagBg}}; color: {{item.danceTagText}}">{{item.danceStyleName}}</view>
              <text class="cih-name">{{item.course_name || '课程'}}</text>
              <view class="cih-meta">
                <text class="cih-day">{{item.weekday || ''}}</text>
                <text class="cih-time">{{item.timeDisplay}}</text>
              </view>
            </view>
          </view>
          </view>
        </scroll-view>
        <view class="empty-inline" wx:else>
          <text class="eit">暂无场次安排</text>
        </view>
      </view>

      <view class="gallery-section" wx:if="{{images.length > 0}}">
        <view class="gs-header" bindtap="onGalleryMore">
          <view class="gs-title-line">
            <view class="gs-accent"></view>
            <text class="gs-title">此间画面</text>
            <view class="gs-accent"></view>
          </view>
          <view class="gs-more-row">
            <text class="gs-subtitle">舞栖瞬间 · 光影留存</text>
            <view class="gs-more">
              <text>查看全部</text>
              <text class="gs-more-arrow">›</text>
            </view>
          </view>
        </view>
        <scroll-view class="gs-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="gs-scroll-inner">
          <view class="gs-frame {{item.orientation === 'portrait' ? 'gs-portrait' : 'gs-landscape'}}" wx:for="{{images}}" wx:key="_id" bindtap="onGalleryTap">
            <view class="gs-frame-inner">
              <image class="gs-img" src="{{imageErrors['gallery_'+item._id] ? '/images/default-course.svg' : (item.thumbnail_url || item.image_url)}}" mode="aspectFill" lazy-load="{{true}}" decoding="async" binderror="onImageError" data-id="{{item._id}}" />
            </view>
          </view>
          </view>
        </scroll-view>
        <view class="booking-disclaimer">成人零基础・舞蹈健身服务</view>
      </view>
    </view>
  </block>

  <!-- ===== 皮肤：纸上舞台 ===== -->
  <block wx:if="{{skinId === 'paper'}}">
    <view class="pi-wrap" style="padding-top: {{(statusBarHeight || 44) + 8}}px;">
      <view class="pi-holiday" wx:if="{{activeHolidays.length > 0}}">假期提醒：{{activeHolidays[0].date}} 起的放假安排已生效，相关课程以最新课表为准</view>

      <view class="pi-masthead">
        <view class="pi-brand">
          <view class="pi-brand-seal">栖</view>
          <view class="pi-brand-line">
            <text class="pi-brand-name">舞栖</text>
            <text class="pi-brand-en">WUQI DANCE</text>
          </view>
        </view>
      </view>

      <view class="pi-hero">
        <view class="pi-hero-lines"></view>
        <text class="pi-hero-en">WUQI DANCE · MOVEMENT ARCHIVE</text>
        <view class="pi-hero-vt">
          <text class="pi-vt-text">以舞为栖</text>
          <view class="pi-vt-seal">栖</view>
        </view>
        <view class="pi-hero-month">{{greeting.text}}</view>
        <view class="pi-hero-sub" bindtap="onStoreTap">{{currentStore.name || '选择门店'}} · 切换</view>
      </view>

      <view class="pi-sec">
        <view class="pi-sec-h">
          <text class="pi-sec-no">壹</text>
          <text class="pi-sec-t">{{t.secNotices}}</text>
          <text class="pi-sec-en">NOTICES</text>
        </view>
        <view class="pi-sec-rule"></view>
        <block wx:if="{{announces.length > 0}}">
          <view class="pi-notice" wx:for="{{announces}}" wx:key="_id" wx:if="{{index < 3}}" bindtap="onAnnounceTap">
            <text class="pi-n-no">0{{index + 1}}</text>
            <text class="pi-n-t">{{item.title || item.content}}</text>
            <text class="pi-n-tag" wx:if="{{index === 0}}">新</text>
            <text class="pi-n-date" wx:if="{{index > 0}}">{{item.createdAtDisplay}}</text>
          </view>
        </block>
        <view class="pi-empty" wx:else>近期暂无栖事</view>
      </view>

      <view class="pi-sec">
        <view class="pi-sec-h">
          <text class="pi-sec-no">贰</text>
          <text class="pi-sec-t">{{t.secCoaches}}</text>
          <text class="pi-sec-en">COACHES</text>
        </view>
        <view class="pi-sec-rule"></view>
        <scroll-view class="pi-coaches" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{hotCoaches.length > 0}}">
          <view class="pi-coaches-inner">
          <view class="pi-coach" wx:for="{{hotCoaches}}" wx:key="_id" data-id="{{item._id}}" bindtap="onCoachTap">
            <view class="pi-coach-ph">
              <image class="pi-coach-img" src="{{imageErrors['coach_'+item._id] ? '/images/default-avatar.svg' : (item.avatar_url || '/images/default-avatar.svg')}}" binderror="onImgError" data-type="coach" data-id="{{item._id}}" mode="aspectFill" lazy-load decoding="async" />
              <text class="pi-coach-idx">0{{index + 1}}</text>
            </view>
            <text class="pi-coach-name">{{item.name}}</text>
            <text class="pi-coach-sty" wx:if="{{item.dance_styles.length > 0}}">{{item.dance_styles[0].name}}</text>
          </view>
          </view>
        </scroll-view>
        <view class="pi-empty" wx:else>暂无教练信息</view>
      </view>

      <view class="pi-sec">
        <view class="pi-sec-h">
          <text class="pi-sec-no">叁</text>
          <text class="pi-sec-t">{{t.secCourses}}</text>
          <text class="pi-sec-en">NEXT CLASSES</text>
        </view>
        <view class="pi-sec-rule"></view>

      <block wx:if="{{recentCourses.length > 0}}">
          <view class="pi-course" wx:for="{{recentCourses}}" wx:key="_id" data-id="{{item._id}}" bindtap="onCourseTap">
            <view class="pi-c-time">
              <text class="pi-c-time-b">{{item.timeVisible ? item.start_time : '??:??'}}</text>
              <text class="pi-c-weekday">{{item.weekday}}</text>
            </view>
            <view class="pi-c-main">
              <view class="pi-c-name"><view class="pi-c-dot" style="background: {{item.danceTagBg}};"></view><text>{{item.course_name}}</text></view>
              <text class="pi-c-meta">{{item.coach_id.name || '教练待定'}} · {{item.dateCn}}</text>
            </view>
            <view class="pi-c-btn">{{t.btnBook}}</view>
          </view>
        </block>
        <view class="pi-empty" wx:else>近期暂无场次</view>
      </view>

      <view class="pi-gallery" wx:if="{{images.length > 0}}" bindtap="onGalleryMore">
        <view>
          <text class="pi-gallery-t">此间画面</text>
          <text class="pi-gallery-en">THE WALL · {{images.length}}</text>
        </view>
        <text style="font-size: 30rpx; color: #6C6353;">→</text>
      </view>
      <view class="pi-foot">
        <text class="pi-foot-cn">舞栖舞蹈社</text>
        <text class="pi-foot-en">WUQI DANCE</text>
      </view>
    </view>
  </block>

  <!-- ===== 皮肤：VOLT 舞力场 ===== -->
  <block wx:if="{{skinId === 'volt'}}">
    <view class="vi-store-row" style="top: {{statusBarHeight || 44}}px;">
      <view class="vi-store-btn" catchtap="onStoreTap">{{currentStore.name || '选择门店'}} ›</view>
    </view>
    <view class="vi-marquee" style="top: {{(statusBarHeight || 44) + 44}}px;">
      <view class="vi-mq-track">
        <view class="vi-mq-group" wx:for="{{[1,2]}}" wx:key="*this">
          <text class="vi-mq-item">{{currentStore.name || '舞栖舞蹈社'}}</text>
          <text class="vi-mq-sep">✺</text>
          <text class="vi-mq-item">近期登场 {{recentCourses.length}} 场</text>
          <text class="vi-mq-sep">✺</text>
          <block wx:if="{{recentCourses[0].timeVisible && recentCourses.length > 0}}">
            <text class="vi-mq-item">{{recentCourses[0].start_time}} {{recentCourses[0].course_name}} 仅剩 {{recentCourses[0].max_bookings - recentCourses[0].current_bookings}} 席</text>
            <text class="vi-mq-sep">✺</text>
          </block>
        </view>
      </view>
    </view>
    <view class="vi-wrap" style="padding-top: {{(statusBarHeight || 44) + 92}}px;">
      <view class="vi-brand">
        <view class="vi-brand-mark">栖</view>
        <view class="vi-brand-line">
          <text class="vi-brand-name">舞栖</text>
          <text class="vi-brand-en">WUQI DANCE CLUB</text>
        </view>
      </view>
      <view class="vi-rhythm">
        <view class="vi-rhythm-head">
          <text class="vi-rhythm-t">你的节奏</text>
          <view class="vi-rhythm-bpm"><text>128 BPM</text></view>
        </view>
        <view class="vi-rhythm-ecg"></view>
        <text class="vi-rhythm-sub" wx:if="{{rhythmData.weekCount || rhythmData.totalCount}}">本周已上 {{rhythmData.weekCount}} 节 · 累计 {{rhythmData.totalCount}} 节 —— 别停，气场正热</text>
        <text class="vi-rhythm-sub" wx:else>约课打卡，节奏自见 —— 舞社见</text>
      </view>
      <view class="vi-hero">
        <text class="vi-hero-k">TODAY · {{greeting.text}}</text>
        <view class="vi-hero-t">
          <text class="vi-hero-cn">近期登场</text>
          <text class="vi-hero-cnt">{{recentCourses.length < 10 ? '0' + recentCourses.length : recentCourses.length}}</text>
        </view>
      </view>
      <block wx:if="{{recentCourses.length > 0}}">
        <view class="vi-bill {{item._ongoing ? 'live' : ''}}" wx:for="{{recentCourses}}" wx:key="_id" style="animation-delay: {{(index > 5 ? 5 : index) * 70}}ms" data-id="{{item._id}}" bindtap="onCourseTap">
          <view class="vi-bill-badge">{{item.sessionLabel}}</view>
          <text class="vi-bill-wd">{{item.weekday}} {{item.dateCn}}</text>
          <text class="vi-bill-time">{{item.timeVisible ? item.start_time : '??:??'}}-{{item.timeVisible ? item.end_time : '??'}}</text>
          <text class="vi-bill-name">{{item.course_name}}</text>
          <text class="vi-bill-spark">✺</text>
        </view>
      </block>
      <view class="vi-empty" wx:else>近期暂无场次 · 舞社见</view>
<view class="vi-coach-sec">
        <view class="vi-sec-h">
          <text class="vi-sec-t">{{t.secCoaches}}</text>
          <text class="vi-sec-en" bindtap="goCoachList">{{t.btnMore}} →</text>
        </view>
        <scroll-view class="vi-coaches" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{hotCoaches.length > 0}}">
          <view class="vi-coaches-inner">
          <view class="vi-coach" wx:for="{{hotCoaches}}" wx:key="_id" data-id="{{item._id}}" bindtap="onCoachTap">
            <view class="vi-coach-ph">
              <image class="vi-coach-img" src="{{imageErrors['coach_'+item._id] ? '/images/default-avatar.svg' : (item.avatar_url || '/images/default-avatar.svg')}}" binderror="onImgError" data-type="coach" data-id="{{item._id}}" mode="aspectFill" lazy-load decoding="async" />
            </view>
            <text class="vi-coach-name">{{item.name}}</text>
            <text class="vi-coach-sty" wx:if="{{item.dance_styles.length > 0}}">{{item.dance_styles[0].name}}</text>
          </view>
          </view>
        </scroll-view>
        <view class="vi-empty" wx:else>暂无教练信息</view>
      </view>

      <view class="vi-gallery" wx:if="{{images.length > 0}}" bindtap="onGalleryMore">
        <text>此间画面 · THE WALL</text>
        <text class="vi-gallery-arrow">→</text>
      </view>

      <view class="vi-foot">WUQI DANCE CLUB · 舞社见</view>
    </view>
  </block>
  </view>
</view>
</scroll-view>

<!-- 弹窗统一放在 scroll-view 外层：不随内容滚动，fixed 定位更稳定 -->
  <block wx:if="{{skinId === 'classic'}}">
<view class="modal-mask store-modal" wx:if="{{showStoreModal}}" bindtap="onCloseStoreModal">
    <view class="modal-content" catchtap="onModalTap">
      <view class="modal-title-text">选择门店</view>
      <view class="store-list" wx:if="{{storeList.length > 0}}">
        <view class="store-opt {{currentStore && currentStore._id === item._id ? 'active' : ''}}" wx:for="{{storeList}}" wx:key="_id" data-store="{{item}}" bindtap="onSelectStore">
          <view class="store-opt-left">
            <text class="store-opt-name">{{item.name}}</text>
            <text class="store-opt-distance" wx:if="{{item.distance !== undefined && item.distance !== null}}">{{fmt.distance(item.distance)}}</text>
          </view>
          <view class="store-opt-check" wx:if="{{currentStore && currentStore._id === item._id}}"></view>
        </view>
      </view>
      <view class="store-empty" wx:else>
        <text>暂无门店数据</text>
      </view>
      <view class="modal-close-btn" bindtap="onCloseStoreModal">关闭</view>
    </view>
  </view>
</block>

<!-- 纸上舞台 / VOLT：门店选择器抽屉（与约课页同款） -->
<block wx:if="{{skinId !== 'classic'}}">
  <view class="bk-store-mask {{skinId === 'volt' ? 'bk-store-mask-volt' : ''}}" wx:if="{{showStoreModal}}" bindtap="onCloseStoreModal">
    <view class="bk-store-sheet" catchtap="onModalTap">
      <view class="bk-st-handle"></view>
      <view class="bk-st-head">
        <text class="bk-st-title">选择门店</text>
        <text class="bk-st-sub">切换门店后将重新加载课程</text>
      </view>
      <view class="bk-st-list">
        <view class="bk-st-opt {{currentStore && currentStore._id === item._id ? 'on' : ''}}" wx:for="{{storeList}}" wx:key="_id" data-store="{{item}}" bindtap="onSelectStore">
          <view class="bk-st-opt-main">
            <text class="bk-st-opt-name">{{item.name}}</text>
            <text class="bk-st-opt-addr" wx:if="{{item.distance !== undefined && item.distance !== null}}">{{fmt.distance(item.distance)}}</text>
          </view>
          <text class="bk-st-opt-check" wx:if="{{currentStore && currentStore._id === item._id}}">{{skinId === 'paper' ? '使用中' : 'ON'}}</text>
        </view>
      </view>
      <view class="bk-st-close" bindtap="onCloseStoreModal">关闭</view>
    </view>
  </view>
</block>

  <!-- 公告弹窗 -->
  <view class="modal-mask announce-modal" wx:if="{{ showAnnounceModal }}" catchtouchmove="onPreventMove">
    <view class="am-wrapper" catchtouchmove="onPreventMove">
      <view class="am-stack" style="transform: translateX({{stackShift}}rpx);">
        <view class="am-card am-card-below" wx:for="{{ announces }}" wx:key="_id" wx:if="{{ idx > announceSwiperIndex }}" wx:for-index="idx" wx:for-item="card" style="transform: translateX({{idx * stackEdgeWidth}}rpx); z-index: {{10 - (idx - announceSwiperIndex)}};">
          <view class="am-header">
            <view class="am-badge">
              <view class="am-badge-icon"></view>
              <text class="am-badge-text">公告</text>
            </view>
          </view>
          <view class="am-body">
            <text class="am-title">{{card.title}}</text>
            <view class="am-line"></view>
            <scroll-view class="am-content" scroll-y enhanced show-scrollbar="{{ false }}">
              <text class="am-text">{{card.content}}</text>
            </scroll-view>
          </view>
          <view class="am-footer">
            <view class="am-date-wrap">
              <view class="am-date-dot"></view>
              <text class="am-date">{{card.createdAtDisplay}}</text>
            </view>
          </view>
        </view>
        <view class="am-card am-card-return" wx:if="{{returnCardVisible}}" style="transform: translateX({{(announceSwiperIndex - 1) * stackEdgeWidth}}rpx) translateX({{returnCardOffsetX}}px); transition: {{isDragging ? 'none' : 'transform 300ms ease'}}; z-index: 25;">
          <view class="am-header">
            <view class="am-badge">
              <view class="am-badge-icon"></view>
              <text class="am-badge-text">公告</text>
            </view>
            <text class="am-page" wx:if="{{ hasMultipleAnnounces }}">{{ announceSwiperIndex }}/{{ announces.length }}</text>
          </view>
          <view class="am-body">
            <text class="am-title">{{ announces[announceSwiperIndex - 1].title }}</text>
            <view class="am-line"></view>
            <scroll-view class="am-content" scroll-y enhanced show-scrollbar="{{ false }}">
              <text class="am-text">{{ announces[announceSwiperIndex - 1].content }}</text>
            </scroll-view>
          </view>
          <view class="am-footer">
            <view class="am-date-wrap">
              <view class="am-date-dot"></view>
              <text class="am-date">{{ announces[announceSwiperIndex - 1].createdAtDisplay }}</text>
            </view>
          </view>
        </view>
        <view class="am-card-front" style="transform: translateX({{announceSwiperIndex * stackEdgeWidth}}rpx); z-index: 20;">
          <view class="am-card am-card-drag" style="transform: translateX({{cardOffsetX}}px); transition: {{isDragging ? 'none' : 'transform 300ms ease, opacity 300ms ease'}}; opacity: {{cardOpacity}};" bindtouchstart="onCardTouchStart" bindtouchmove="onCardTouchMove" bindtouchend="onCardTouchEnd">
            <view class="am-header">
              <view class="am-badge">
                <view class="am-badge-icon"></view>
                <text class="am-badge-text">公告</text>
              </view>
              <text class="am-page" wx:if="{{ hasMultipleAnnounces }}">{{ announceSwiperIndex + 1 }}/{{ announces.length }}</text>
            </view>
            <view class="am-body">
              <text class="am-title">{{ announces[announceSwiperIndex].title }}</text>
              <view class="am-line"></view>
              <scroll-view class="am-content" scroll-y enhanced show-scrollbar="{{ false }}">
                <text class="am-text">{{ announces[announceSwiperIndex].content }}</text>
              </scroll-view>
            </view>
            <view class="am-footer">
              <view class="am-date-wrap">
                <view class="am-date-dot"></view>
                <text class="am-date">{{ announces[announceSwiperIndex].createdAtDisplay }}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="am-close-btn" bindtap="onCloseAnnounceModal">
        <view class="am-close-ring">
          <view class="am-close-x"></view>
        </view>
        <text class="am-close-label">关闭</text>
      </view>
    </view>
  </view>

  <login-modal visible="{{showLoginModal}}" bind:close="onLoginModalClose" bind:success="onLoginSuccess"></login-modal>

  <!-- 位置授权弹窗 -->
  <view class="modal-mask" wx:if="{{showLocationAuthModal}}" catchtap="">
    <view class="lam-card">
      <view class="lam-icon-wrap">
        <view class="lam-icon"></view>
      </view>
      <text class="lam-title">开启位置服务</text>
      <text class="lam-desc">授权位置信息后，为您智能匹配距离最近的门店，推荐附近的课程和教练。</text>
      <view class="lam-btns">
        <view class="lam-btn lam-btn-cancel" bindtap="onLocationAuthCancel">
          <text>暂不</text>
        </view>
        <view class="lam-btn lam-btn-confirm" bindtap="onLocationAuthConfirm">
          <text>去授权</text>
        </view>
      </view>
    </view>
  </view>
  <!-- 公告自动弹窗（一般/重要/永久三种类型，样式见 components/announce-popup） -->
  <announce-popup visible="{{showAnnouncePopup}}" announce="{{popupAnnounce}}" bind:close="onAnnouncePopupClose"></announce-popup>

<update-modal />
