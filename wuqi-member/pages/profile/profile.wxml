<view class="page-scroll">
<!-- 自绘标题栏：结构与样式与场次预约页（pages/booking classic）完全一致，保证两页标题大小/字体/渲染方式一模一样 -->
<view class="cl-navbar pf-navbar-{{skinId}}" style="padding-top: {{(statusBarHeight || 44) + 6}}px;">
  <text class="cl-navbar-title">个人中心</text>
</view>
<!-- 顶部占位：替代原系统导航栏高度（状态栏 + 44px），使内容位置与切换前一致 -->
<view class="pf-nav-spacer pf-sp-{{skinId}}" style="height: {{(statusBarHeight || 44) + 44}}px;"></view>
<view class="profile-page skin-root skin-{{skinId}}">
  <block wx:if="{{isLoggedIn}}">
    <block wx:if="{{skinId === 'classic'}}">
    <view class="hero-card">
      <view class="hero-top">
        <view class="hero-avatar-wrap" bindtap="onHeroAvatarTap">
          <image class="hero-avatar" src="{{avatarSrc}}" binderror="onImgError" data-type="avatar" data-id="user" mode="aspectFill" decoding="async"></image>
          <view class="hero-avatar-ring"></view>
          <view class="hero-avatar-tip" wx:if="{{isOfficialMember && (!userInfo.avatar && !userInfo.avatar_url || avatarImageError)}}">
            <text class="hero-avatar-tip-text">点击更换</text>
          </view>
        </view>
        <view class="hero-info">
          <view class="hero-name-row">
            <text class="hero-name">{{userInfo.real_name || userInfo.nickname || (isOfficialMember ? '舞栖会员' : '注册用户')}}</text>
            <view class="hero-gender male" wx:if="{{userInfo.gender === 1}}">
              <view class="hero-gender-icon-m"></view>
            </view>
            <view class="hero-gender female" wx:if="{{userInfo.gender === 2}}">
              <view class="hero-gender-icon-f"></view>
            </view>
          </view>
          <text class="hero-member-id" wx:if="{{userInfo.member_code}}">会员编号：{{userInfo.member_code}}</text>
          <text class="hero-since">加入{{memberSinceDays}}天</text>
        </view>
        <view class="hero-action" wx:if="{{userInfo.member_status === 'official'}}">
          <view class="qr-btn" bindtap="onShowQRCode">
            <view class="qr-btn-icon"></view>
            <text class="qr-btn-text">会员码</text>
          </view>
        </view>
      </view>
      <view class="hero-status-row" wx:if="{{userInfo.member_status === 'official'}}">
        <view class="status-chip {{memberStatus}}">
          <text>{{memberStatusText}}</text>
        </view>
        <text class="status-sub" wx:if="{{currentPackageType}}">当前套餐：{{currentPackageType}}</text>
        <text class="status-sub" wx:if="{{memberStatus === 'suspended'}}">有效期已冻结，复卡后继续</text>
        <view class="hero-exemption exemption-anchor" wx:if="{{userInfo.exemption_count > 0}}" bindtap="onToggleExemptionTip">
          <text>豁免取消剩余{{userInfo.exemption_count}}次</text>
          <text class="hero-exemption-q">?</text>
        </view>
      </view>
    </view>
    </block>

    <!-- 纸上舞台：会员志（纸底直排） -->
    <block wx:if="{{skinId === 'paper' && isOfficialMember}}">
      <view class="pf-hero-paper">
        <view class="pfp-row">
          <view class="pfp-ava">
            <image class="pfp-ava-img" src="{{avatarSrc}}" binderror="onImgError" data-type="avatar" data-id="user" mode="aspectFill" />
          </view>
          <view class="pfp-info">
            <view class="pfp-nm-row">
              <text class="pfp-name">{{userInfo.real_name || userInfo.nickname || '舞栖会员'}}</text>
              <view class="pfp-seal">正</view>
              <text class="pfp-exempt exemption-anchor" wx:if="{{userInfo.exemption_count > 0}}" bindtap="onToggleExemptionTip">豁免取消剩余{{userInfo.exemption_count}}次</text>
            </view>
            <text class="pfp-sub" wx:if="{{userInfo.member_code}}">会员编号 {{userInfo.member_code}} · 与舞栖同行 {{memberSinceDays}} 天</text>
            <text class="pfp-sub" wx:else>与舞栖同行 {{memberSinceDays}} 天</text>
            <text class="pfp-sub pfp-sub-pause" wx:if="{{memberStatus === 'suspended'}}">停卡中 · 有效期冻结</text>
          </view>
        </view>
      </view>
    </block>

    <!-- VOLT：护照名片 -->
    <block wx:if="{{skinId === 'volt' && isOfficialMember}}">
      <view class="pf-hero-volt">
        <view class="pfv-row">
          <view class="pfv-ava">
            <image class="pfv-ava-img" src="{{avatarSrc}}" binderror="onImgError" data-type="avatar" data-id="user" mode="aspectFill" />
          </view>
          <view class="pfv-info">
            <text class="pfv-name">{{userInfo.real_name || userInfo.nickname || '舞栖会员'}}</text>
            <text class="pfv-sub" wx:if="{{userInfo.member_code}}">NO. {{userInfo.member_code}} · DANCE PASSPORT</text>
          </view>
        </view>
        <view class="pfv-status-row">
          <view class="pfv-chip">{{memberStatusText}}</view>
          <text class="pfv-exempt exemption-anchor" wx:if="{{userInfo.exemption_count > 0}}" bindtap="onToggleExemptionTip">豁免 {{userInfo.exemption_count}} 次</text>
        </view>
      </view>
    </block>

    <view class="pending-section" wx:if="{{userInfo.member_status === 'registered'}}">
      <view class="pending-card">
        <view class="pending-icon-wrap">
          <view class="pending-icon"></view>
        </view>
        <view class="pending-text">
          <text class="pending-title">审核中</text>
          <text class="pending-desc">您的会员申请正在审核中，请耐心等待</text>
        </view>
      </view>
    </view>

    <view class="setup-guide-section" wx:if="{{userInfo.member_status === 'official' && !userInfo.info_completed && !isPreRegistered}}">
      <view class="setup-guide-card" bindtap="onGoSetup">
        <view class="setup-guide-icon-wrap">
          <view class="setup-guide-icon"></view>
        </view>
        <view class="setup-guide-text">
          <text class="setup-guide-title">审核已通过，请完善个人资料</text>
          <text class="setup-guide-desc">完善资料后即可预约课程</text>
        </view>
        <view class="setup-guide-arrow">
          <text>›</text>
        </view>
      </view>
    </view>

    <block wx:if="{{skinId === 'classic'}}">
    <view class="stats-section" wx:if="{{userInfo.member_status === 'official'}}">
      <view class="stats-row {{showExtraStat ? 'stats-row-4' : ''}}">
        <view class="stat-card stat-clickable" bindtap="onStatTap" data-tab="booking">
          <text class="stat-num">{{statsReady ? stats.totalBookings : '--'}}</text>
          <text class="stat-label">待上课</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-card stat-clickable" bindtap="onStatTap" data-tab="attendance">
          <text class="stat-num">{{statsReady ? stats.completedClasses : '--'}}</text>
          <text class="stat-label">已上课</text>
        </view>
        <view class="stat-divider"></view>
        <!-- 单个活跃套餐：显示对应统计 -->
        <block wx:if="{{!showExtraStat}}">
          <view class="stat-card">
            <text class="stat-num {{activeStats[0].isUnlimited ? 'stat-infinity' : ''}}">{{statsReady ? (activeStats.length > 0 ? (activeStats[0].isUnlimited ? '∞' : activeStats[0].remaining) : '--') : '--'}}</text>
            <text class="stat-label">{{activeStats.length > 0 ? activeStats[0].label : '本周剩余'}}</text>
          </view>
        </block>
        <!-- 多个活跃套餐：增加统计卡，两种套餐同时显示 -->
        <block wx:if="{{showExtraStat}}">
          <view class="stat-card">
            <text class="stat-num {{activeStats[0].isUnlimited ? 'stat-infinity' : ''}}">{{statsReady ? (activeStats[0].isUnlimited ? '∞' : activeStats[0].remaining) : '--'}}</text>
            <text class="stat-label">{{activeStats[0].label}}</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-card">
            <text class="stat-num {{activeStats[1].isUnlimited ? 'stat-infinity' : ''}}">{{statsReady ? (activeStats[1].isUnlimited ? '∞' : activeStats[1].remaining) : '--'}}</text>
            <text class="stat-label">{{activeStats[1].label}}</text>
          </view>
        </block>
      </view>
    </view>

    <view class="stats-section guest-stats" wx:if="{{userInfo.member_status !== 'official'}}">
      <view class="stats-row">
        <view class="stat-card guest-stat">
          <text class="stat-num">--</text>
          <text class="stat-label">待上课</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-card guest-stat">
          <text class="stat-num">--</text>
          <text class="stat-label">已上课</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-card guest-stat">
          <text class="stat-num">--</text>
          <text class="stat-label">本周剩余</text>
        </view>
      </view>
    </view>

    </block>

    <!-- 纸上舞台：三数据（同时持有次卡+时间卡时扩展为四数据） -->
    <block wx:if="{{skinId === 'paper' && userInfo.member_status === 'official'}}">
      <view class="pf-stats-paper {{showExtraStat ? 'pf-stats-4' : ''}}">
        <view class="pf-st" bindtap="onStatTap" data-tab="booking">
          <text class="pf-st-n">{{statsReady ? stats.totalBookings : '--'}}</text>
          <text class="pf-st-l">待上课</text>
        </view>
        <view class="pf-st" bindtap="onStatTap" data-tab="attendance">
          <text class="pf-st-n">{{statsReady ? stats.completedClasses : '--'}}</text>
          <text class="pf-st-l">已上课</text>
        </view>
        <view class="pf-st">
          <text class="pf-st-n pf-st-gold">{{statsReady ? (activeStats.length > 0 ? (activeStats[0].isUnlimited ? '∞' : activeStats[0].remaining) : '--') : '--'}}</text>
          <text class="pf-st-l">{{activeStats.length > 0 ? activeStats[0].label : '剩余课时'}}</text>
        </view>
        <view class="pf-st" wx:if="{{showExtraStat}}">
          <text class="pf-st-n pf-st-gold">{{statsReady ? (activeStats.length > 1 ? (activeStats[1].isUnlimited ? '∞' : activeStats[1].remaining) : '--') : '--'}}</text>
          <text class="pf-st-l">{{activeStats.length > 1 ? activeStats[1].label : '剩余'}}</text>
        </view>
      </view>
    </block>

    <!-- VOLT：三数据（同时持有次卡+时间卡时扩展为四数据） -->
    <block wx:if="{{skinId === 'volt' && userInfo.member_status === 'official'}}">
      <view class="pf-stats-volt {{showExtraStat ? 'pf-stats-4' : ''}}">
        <view class="pv-st" bindtap="onStatTap" data-tab="booking">
          <text class="pv-st-n">{{statsReady ? stats.totalBookings : '--'}}</text>
          <text class="pv-st-l">待上课</text>
        </view>
        <view class="pv-st" bindtap="onStatTap" data-tab="attendance">
          <text class="pv-st-n">{{statsReady ? stats.completedClasses : '--'}}</text>
          <text class="pv-st-l">已上课</text>
        </view>
        <view class="pv-st pv-st-hot">
          <text class="pv-st-n">{{statsReady ? (activeStats.length > 0 ? (activeStats[0].isUnlimited ? '∞' : activeStats[0].remaining) : '--') : '--'}}</text>
          <text class="pv-st-l">{{activeStats.length > 0 ? activeStats[0].label : '课时'}}</text>
        </view>
        <view class="pv-st pv-st-hot" wx:if="{{showExtraStat}}">
          <text class="pv-st-n">{{statsReady ? (activeStats.length > 1 ? (activeStats[1].isUnlimited ? '∞' : activeStats[1].remaining) : '--') : '--'}}</text>
          <text class="pv-st-l">{{activeStats.length > 1 ? activeStats[1].label : '剩余'}}</text>
        </view>
      </view>
    </block>

    <!-- VOLT：最近一课（真实上课记录的快捷呈现；纸上舞台无此模块） -->
    <block wx:if="{{skinId === 'volt' && isOfficialMember && lastSession}}">
      <view class="pf-last-sec">
        <view class="pf-last-head"><text class="pf-last-t">最近一课</text><text class="pf-last-en">LAST SESSION</text></view>
        <view class="pf-last-card">
          <view class="pfl-mark">✓</view>
          <view class="pfl-main">
            <text class="pfl-name">{{lastSession.name}}</text>
            <text class="pfl-meta">{{lastSession.meta}}</text>
          </view>
          <view class="pfl-k">已上课 第 {{lastSession.index}} 节</view>
        </view>
      </view>
    </block>

    <block wx:if="{{skinId === 'classic' && userInfo.member_status === 'official'}}">
    <view class="package-section" wx:if="{{userInfo.member_status === 'official'}}">
      <block wx:if="{{allPackages.length > 0}}">
        <view class="section-header">
          <view class="section-header-left">
            <view class="section-left-bar"></view>
            <text class="section-title">我的套餐</text>
          </view>
        </view>

        <!-- 使用中套餐卡片（支持多个） -->
        <block wx:for="{{activePackages}}" wx:key="_id" wx:if="{{activePackages.length > 0}}">
        <view class="pkg-card-new {{item.status}} {{item.package_type}}" bindtap="onPackageTap" data-id="{{item._id}}">
          <view class="pkg-new-decorate-circle"></view>
          <view class="pkg-new-content">
            <view class="pkg-new-header">
              <view class="pkg-tag pkg-tag-store" wx:if="{{item._storeName}}">
                <text class="pkg-tag-text">{{item._storeName}}</text>
              </view>
              <view class="pkg-tag pkg-tag-cross-store" wx:if="{{item._crossStore}}">
                <text class="pkg-tag-text">可跨店</text>
              </view>
              <view class="pkg-tag pkg-tag-type-{{item.package_type}} {{item._isBonus ? 'pkg-tag-bonus' : ''}}" wx:if="{{item._typeLabel}}">
                <text class="pkg-tag-text">{{item._typeLabel}}</text>
              </view>
            </view>
            <text class="pkg-source" wx:if="{{item._isBonus && item._sourceText}}">{{item._sourceText}}</text>
            <!-- 可用星期/可用时段：独立整行展示，门店/类型标签下方 -->
            <view class="pkg-new-weekday-row {{item._timeLimitBoth ? 'pkg-new-time-both' : ''}}" wx:if="{{item._weekdayLimitText || item._timeLimitText}}">
              <view class="pkg-tag pkg-tag-weekday" wx:if="{{item._weekdayLimitText}}">
                <text class="pkg-tag-text">{{item._weekdayLimitText}}可用</text>
              </view>
              <view class="pkg-tag pkg-tag-time" wx:if="{{item._timeLimitText}}">
                <text class="pkg-tag-text">{{item._timeLimitText}}可用</text>
              </view>
            </view>
            <view class="pkg-new-main">
              <view class="pkg-new-main-left">
                <!-- 次卡：双列大数字 -->
                <view class="pkg-new-main-value-wrap pkg-new-dual-wrap" wx:if="{{item.package_type === 'count_card'}}">
                  <view class="pkg-new-dual-col">
                    <view class="pkg-new-dual-value-wrap">
                      <text class="pkg-new-main-value">{{item.remaining_credits || 0}}</text>
                      <text class="pkg-new-main-unit">次</text>
                    </view>
                    <text class="pkg-new-main-label">剩余次数</text>
                  </view>
                  <view class="pkg-new-dual-col">
                    <view class="pkg-new-dual-value-wrap">
                      <text class="pkg-new-main-value pkg-new-days-value">{{item.remaining_days || 0}}</text>
                      <text class="pkg-new-main-unit pkg-new-days-unit">天</text>
                    </view>
                    <text class="pkg-new-main-label">剩余天数</text>
                  </view>
                </view>
                <!-- 时间卡：双列大数字（剩余天数 + 周期剩余次数） -->
                <view class="pkg-new-main-value-wrap pkg-new-dual-wrap" wx:elif="{{item.package_type === 'time_card' && item._hasPeriodLimit}}">
                  <view class="pkg-new-dual-col">
                    <view class="pkg-new-dual-value-wrap">
                      <text class="pkg-new-main-value pkg-new-days-value">{{item.remaining_days || 0}}</text>
                      <text class="pkg-new-main-unit pkg-new-days-unit">天</text>
                    </view>
                    <text class="pkg-new-main-label">剩余天数</text>
                  </view>
                  <view class="pkg-new-dual-col" wx:if="{{item._weekRemaining === -1}}">
                    <view class="pkg-new-dual-value-wrap">
                      <text class="pkg-new-main-value pkg-new-inf-value">∞</text>
                    </view>
                    <text class="pkg-new-main-label">不限次</text>
                  </view>
                  <view class="pkg-new-dual-col" wx:else>
                    <view class="pkg-new-dual-value-wrap">
                      <text class="pkg-new-main-value pkg-new-credits-value">{{item._weekRemaining}}</text>
                      <text class="pkg-new-main-unit pkg-new-credits-unit">次</text>
                    </view>
                    <text class="pkg-new-main-label">{{item._periodLabel}}剩余</text>
                  </view>
                </view>
                <!-- 时间卡（无周期数据）：单列大数字 -->
                <view class="pkg-new-main-value-wrap" wx:elif="{{item.package_type === 'time_card'}}">
                  <text class="pkg-new-main-value">{{item.remaining_days || 0}}</text>
                  <text class="pkg-new-main-unit">天</text>
                </view>
                <text class="pkg-new-main-label" wx:if="{{item.package_type === 'time_card' && !item._hasPeriodLimit}}">剩余天数</text>
                <view class="pkg-new-status-dot-wrap {{item.status}} {{item.is_suspended ? 'suspended' : ''}}">
                  <view class="pkg-new-status-dot"></view>
                  <text class="pkg-new-status-label">{{item._statusText}}</text>
                </view>
              </view>
              <view class="pkg-new-main-right">
                <view class="pkg-new-info-capsule" wx:if="{{item.package_type === 'time_card'}}">
                  <text class="pkg-new-info-capsule-label">服务有效期</text>
                  <text class="pkg-new-info-capsule-value">{{item._durationText}}</text>
                </view>
                <view class="pkg-new-info-capsule" wx:if="{{item.package_type === 'count_card'}}">
                  <text class="pkg-new-info-capsule-label">{{item._totalLabel}}</text>
                  <text class="pkg-new-info-capsule-value">{{item._totalValue}}</text>
                </view>
                <view class="pkg-new-info-capsule" wx:if="{{item.package_type === 'time_card' && item._hasPeriodLimit}}">
                  <text class="pkg-new-info-capsule-label">周期限制</text>
                  <text class="pkg-new-info-capsule-value">{{item._periodLimitText}}</text>
                </view>
                <view class="pkg-new-info-capsule pkg-new-info-capsule-dance" wx:if="{{item._danceStyleLimitText}}">
                  <text class="pkg-new-info-capsule-label">仅限舞种</text>
                  <text class="pkg-new-info-capsule-value">{{item._danceStyleLimitText}}</text>
                </view>
              </view>
            </view>
            <view class="pkg-new-progress" wx:if="{{item._hasProgress}}">
              <view class="pkg-new-progress-bar">
                <view class="pkg-new-progress-fill {{item._progressFillClass}}" style="{{item._progressWidthStyle}}"></view>
              </view>
              <view class="pkg-new-progress-info">
                <text class="pkg-new-progress-label">{{item._progressLabel}}</text>
                <text class="pkg-new-progress-pct">{{item._progressPercent}}%</text>
              </view>
            </view>
            <view class="pkg-new-footer" wx:if="{{item.is_activated && item.start_date_display}}">
              <text class="pkg-new-date-text">服务有效期：{{item.start_date_display}}至{{item.end_date_display}}</text>
            </view>
            <!-- 停卡说明 -->
            <view class="pkg-new-suspend-note" wx:if="{{item.is_suspended}}">
              <text>{{item._suspendNote}}</text>
            </view>
          </view>
        </view>
        </block>

        <!-- 待激活套餐卡片（仅新会员会出现，老会员套餐创建时已直接 active） -->
        <view class="pkg-card-new pending {{item.package_type}}" wx:for="{{pendingPackages}}" wx:key="_id" wx:if="{{pendingPackages.length > 0}}" bindtap="onPackageTap" data-id="{{item._id}}">
          <view class="pkg-new-decorate-circle"></view>
          <view class="pkg-new-content">
            <view class="pkg-new-header">
              <view class="pkg-tag pkg-tag-store" wx:if="{{item._storeName}}">
                <text class="pkg-tag-text">{{item._storeName}}</text>
              </view>
              <view class="pkg-tag pkg-tag-cross-store" wx:if="{{item._crossStore}}">
                <text class="pkg-tag-text">可跨店</text>
              </view>
              <view class="pkg-tag pkg-tag-type-{{item.package_type}} {{item._isBonus ? 'pkg-tag-bonus' : ''}}" wx:if="{{item._typeLabel}}">
                <text class="pkg-tag-text">{{item._typeLabel}}</text>
              </view>
            </view>
            <text class="pkg-source" wx:if="{{item._isBonus && item._sourceText}}">{{item._sourceText}}</text>
            <!-- 可用星期/可用时段：独立整行展示，门店/类型标签下方 -->
            <view class="pkg-new-weekday-row {{item._timeLimitBoth ? 'pkg-new-time-both' : ''}}" wx:if="{{item._weekdayLimitText || item._timeLimitText}}">
              <view class="pkg-tag pkg-tag-weekday" wx:if="{{item._weekdayLimitText}}">
                <text class="pkg-tag-text">{{item._weekdayLimitText}}可用</text>
              </view>
              <view class="pkg-tag pkg-tag-time" wx:if="{{item._timeLimitText}}">
                <text class="pkg-tag-text">{{item._timeLimitText}}可用</text>
              </view>
            </view>
            <view class="pkg-new-main">
              <view class="pkg-new-main-left pkg-new-pending-main">
                <!-- 套餐类型图标 + 静待开启状态 -->
                <view class="pkg-new-pending-hero">
                  <view class="pkg-new-pending-icon pkg-new-pending-icon-{{item.package_type}}"></view>
                </view>
                <view class="pkg-new-status-dot-wrap pending">
                  <view class="pkg-new-status-dot"></view>
                  <text class="pkg-new-status-label">静待开启</text>
                </view>
                <text class="pkg-new-pending-hint" wx:if="{{item._pendingHint}}">{{item._pendingHint}}</text>
              </view>
              <view class="pkg-new-main-right">
                <view class="pkg-new-info-capsule" wx:if="{{item.package_type === 'count_card'}}">
                  <text class="pkg-new-info-capsule-label">套餐次数</text>
                  <text class="pkg-new-info-capsule-value">{{item._pendingCreditsValue}}</text>
                </view>
                <view class="pkg-new-info-capsule" wx:if="{{item._pendingRestrictionLabel}}">
                  <text class="pkg-new-info-capsule-label">{{item._pendingRestrictionLabel}}</text>
                  <text class="pkg-new-info-capsule-value">{{item._pendingRestrictionValue}}</text>
                </view>
                <view class="pkg-new-info-capsule">
                  <text class="pkg-new-info-capsule-label">服务有效期</text>
                  <text class="pkg-new-info-capsule-value">{{item._durationText}}</text>
                </view>
                <view class="pkg-new-info-capsule pkg-new-info-capsule-dance" wx:if="{{item._danceStyleLimitText}}">
