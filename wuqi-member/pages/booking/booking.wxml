<wxs src="../../utils/date-format.wxs" module="df" />
<wxs src="../../utils/dance-colors.wxs" module="dc" />

<view class="booking-page skin-root skin-{{skinId}}">
    <!-- 经典头部 -->
    <block wx:if="{{skinId === 'classic'}}">
    <view class="header-section" style="padding-top: {{(statusBarHeight || 44) + 6}}px;">
      <view class="cl-navbar" style="padding-top: {{(statusBarHeight || 44) + 6}}px;"><text class="cl-navbar-title">{{t.bookingTitle}}</text></view>
      <view class="cl-navbar-spacer"></view>
      <view class="store-card" bindtap="onStoreTap">
        <view class="store-card-left">
          <view class="store-icon-wrap">
            <view class="store-icon-shape"></view>
          </view>
          <view class="store-info">
            <text class="store-name">{{currentStore.name || '选择门店'}}</text>
          </view>
        </view>
        <view class="store-arrow-wrap">
          <view class="store-arrow"></view>
        </view>
      </view>
    </view>
    </block>

    <!-- 纸上舞台头部：门店行 + 标题 -->
    <block wx:if="{{skinId === 'paper'}}">
      <view class="bkp-head" style="padding-top: {{(statusBarHeight || 44) + 6}}px;">
        <view class="bkp-store" bindtap="onStoreTap">
          <text class="bkp-store-name">{{currentStore.name || '选择门店'}}</text>
          <text class="bkp-store-arrow">›</text>
        </view>
        <text class="bkp-title">{{t.bookingTitle}}</text>
        <view class="bkp-sub-row">
          <text class="bkp-kicker">BOOKING · {{currentStore.name || '舞栖'}}</text>
          <text class="bkp-count" wx:if="{{selectedDateItem}}">{{df.formatMD(selectedDateItem.date)}} {{selectedDateItem.weekDay}} · {{courses.length}} {{t.countUnit}}</text>
        </view>
        <view class="bkp-rule"></view>
      </view>
    </block>

    <!-- VOLT 头部（对齐预览：大标题 + kicker 行 + 门店胶囊） -->
    <block wx:if="{{skinId === 'volt'}}">
      <view class="bkv-head" style="padding-top: {{(statusBarHeight || 44) + 6}}px;">
        <view class="bkv-store" bindtap="onStoreTap">
          <text class="bkv-store-name">{{currentStore.name || '选择门店'}}</text>
          <text class="bkv-store-arrow">›</text>
        </view>
        <view class="bkv-title-row">
          <text class="bkv-title">{{t.bookingTitle}}</text>
          <text class="bkv-kicker-cnt" wx:if="{{weekDays.length > 0}}">BOOKING · {{df.formatMD(weekDays[weekDaysIndex].date)}} {{weekDays[weekDaysIndex].weekDay}} · {{weekDays[weekDaysIndex].isToday ? '今日 ' : ''}}{{courses.length}} 场</text>
        </view>
      </view>
    </block>

    <block wx:if="{{skinId === 'classic'}}">
    <view class="section-header">
      <view class="section-title-row">
        <view class="section-dot"></view>
        <text class="section-title">{{sectionTitle}}</text>
      </view>
    </view>
    </block>

    <view class="holiday-notice" wx:if="{{isHolidayToday && holidays.length > 0}}">
      <view class="holiday-notice-icon"></view>
      <text class="holiday-notice-text">放假期间无课程安排</text>
    </view>

    <view class="date-section">
      <view class="date-scroll">
        <view class="date-scroll-inner">
          <block wx:for="{{weekDays}}" wx:key="date">
            <view class="date-item {{selectedDate === item.date ? 'active' : ''}}" data-date="{{item.date}}" data-index="{{index}}" bindtap="onSelectDate">
              <block wx:if="{{skinId === 'volt'}}">
                <text class="date-wd">{{item.weekDayShort}}</text>
                <text class="date-md">{{item.day}}</text>
              </block>
              <block wx:else>
                <text class="date-md">{{df.formatMD(item.date)}}</text>
                <text class="date-wd">{{item.displayDay}}</text>
              </block>
            </view>
          </block>
        </view>
      </view>
    </view>

    <scroll-view class="course-list-scroll" scroll-y enhanced show-scrollbar="{{false}}" wx:if="{{courses.length > 0}}">
      <view class="course-list-inner">

      <!-- 经典皮肤课程卡 -->
      <block wx:if="{{skinId === 'classic'}}">
      <view class="course-card" wx:for="{{courses}}" wx:key="_id" bindtap="onCourseTap" data-course="{{item}}">
          <view class="card-left">
          <image class="coach-avatar" src="{{item.r.coachAvatar}}" mode="aspectFill" wx:if="{{item.r.coachAvatar && !imageErrors['coach_' + item._id]}}" binderror="onCoachImgError" data-id="{{item._id}}" />
          <image class="coach-avatar" src="/images/default-avatar.svg" mode="aspectFill" wx:else />
          <text class="coach-name-below">{{item.r.coachName}}</text>
        </view>
        <view class="card-right">
          <view class="card-right-actions">
            <view class="course-book-btn {{item.r.bookBtnClass}}" data-course="{{item}}" catchtap="onBookCourse">
              <text>{{item.r.bookBtnText}}</text>
            </view>
            <view class="course-book-btn waitlist-btn" wx:if="{{item.r.showWaitlistBtn}}" data-course="{{item}}" data-action="waitlist" catchtap="onBookCourse">
              <text>加入候补</text>
            </view>
          </view>
          <view class="course-time-row">
            <text class="course-time" wx:if="{{item.r.showTime}}">{{item.r.time}}</text>
            <text class="course-time" wx:else>??:?? - ??:??</text>
            <text class="min-capacity-text" wx:if="{{item.r.showMinCapacity}}">{{item.r.minCapacity}}</text>
            <text class="min-capacity-text" wx:else>最低?人成班</text>
          </view>
          <text class="course-title">{{item.course_name || '课程名称'}}</text>
          <view class="course-tag-row">
            <view class="course-tag" wx:if="{{item.r.danceStyle}}" style="background: {{item.r.danceTagBg}}; color: {{item.r.danceTagText}}">{{item.r.danceStyle}}</view>
            <view class="course-tag exempt-lock-tag" wx:if="{{item.r.exemptLockTag}}">不可豁免取消</view>
          </view>
          <text class="course-room" wx:if="{{item.r.showRoom}}">{{item.r.room}}</text>
          <view class="course-deadline-row" wx:if="{{item.r.showDeadline}}">
            <text class="deadline-text">{{item.r.deadlineText}}，人数不足自动取消</text>
            <text class="deadline-text deadline-cancel">截止取消：{{item.r.cancelDeadlineText}}</text>
          </view>
          <view class="card-meta-row">
            <view class="card-stats">
              <text class="capacity-text {{item.r.capacityLocked ? 'capacity-locked' : ''}}">{{item.r.capacity}}</text>
            </view>
            <view class="booked-avatars" wx:if="{{item.r.showAvatars}}">
              <block wx:for="{{item.r.avatarList}}" wx:for-item="user" wx:for-index="ui" wx:key="user_id">
                <image class="booked-avatar" src="{{user.avatar_url}}" mode="aspectFill" style="z-index: {{ui + 1}};" lazy-load />
              </block>
              <view class="booked-more" wx:if="{{item.r.avatarMore > 0}}">
                <text>+{{item.r.avatarMore}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
      </block>

      <!-- 纸上舞台：今日戏单 -->
      <block wx:if="{{skinId === 'paper'}}">
        <view class="bk-show-card sk-rise" wx:for="{{courses}}" wx:key="_id" bindtap="onCourseTap" data-course="{{item}}">
          <view class="bk-sc-head">
            <view class="bk-sc-no">
              <view class="bk-sc-dot" wx:if="{{item.r.danceStyle}}" style="background: {{item.r.danceTagBg}};"></view>
              <text>第 {{index === 0 ? '一' : index === 1 ? '二' : index === 2 ? '三' : index === 3 ? '四' : index + 1}} 场{{item.r.danceStyle ? ' · ' + item.r.danceStyle : ''}}</text>
            </view>
            <text class="bk-sc-time">{{item.r.showTime ? item.start_time : '??:??'}}<text class="bk-sc-time-end">- {{item.r.showTime ? item.end_time : '??'}}</text></text>
          </view>
          <text class="bk-sc-name">{{item.course_name || '课程'}}</text>
          <text class="bk-sc-meta">{{item.r.coachName}}{{item.r.showRoom ? ' · ' + item.r.room : ''}}</text>
          <view class="bk-sc-notes" wx:if="{{item.r.autoCancelText || item.r.showDeadline}}">
            <text class="bk-sc-autocancel" wx:if="{{item.r.autoCancelText}}">{{item.r.autoCancelText}}</text>
            <text class="bk-sc-cancel" wx:if="{{item.r.showDeadline}}">截止取消：{{item.r.cancelDeadlineText}}</text>
          </view>
          <view class="bk-sc-foot">
            <view class="bk-sc-seat">
              <view class="bk-sc-seat-top">
                <text>{{item.r.showTime ? item.r.capacity : '已约 ?/? 席'}}</text>
                <text class="bk-sc-mincap" wx:if="{{item.r.showMinCapacity}}">{{item.r.minCapacity}}</text>
              </view>
              <view class="bk-sc-line"><view class="bk-sc-line-fill"></view></view>
            </view>
            <view class="bk-btn {{item.r.bookBtnType}}" data-course="{{item}}" catchtap="onBookCourse">
              <text>{{item.r.bookBtnType === 'book' ? t.btnBook : item.r.bookBtnText}}</text>
            </view>
          </view>
          <view class="bk-wait-row" wx:if="{{item.r.showWaitlistBtn}}">
            <view class="bk-btn-ghost" data-course="{{item}}" data-action="waitlist" catchtap="onBookCourse">
              <text>{{t.btnWaitlist}}</text>
            </view>
          </view>
        </view>
      </block>

      <!-- VOLT：今日登场（五态按钮：立即锁定/舞社见/候补排队/未开放/进行中·NEXT TIME） -->
      <block wx:if="{{skinId === 'volt'}}">
        <view class="bk-volt-card sk-rise" wx:for="{{courses}}" wx:key="_id" bindtap="onCourseTap" data-course="{{item}}">
          <view class="bk-v-locked" wx:if="{{item.r.bookBtnType === 'booked'}}">LOCKED</view>
          <text class="bk-ghost">{{index < 9 ? '0' + (index + 1) : index + 1}}</text>
          <view class="bk-v-top">
            <view class="bk-v-tag bk-v-live" wx:if="{{item._ongoing}}"><view class="bk-v-live-dot"></view>LIVE</view>
            <view class="bk-v-tag" wx:elif="{{item.r.danceStyle}}">{{item.r.danceStyle}}</view>
            <view class="bk-v-time"><text class="bk-v-wd" wx:if="{{item.r.weekday}}">{{item.r.weekday}}</text>{{item.r.showTime ? item.start_time : '??:??'}}<text class="bk-v-time-end">- {{item.r.showTime ? item.end_time : '??'}}</text></view>
          </view>
          <view class="bk-v-body">
            <text class="bk-v-name">{{item.course_name || '课程'}}</text>
            <view class="bk-v-meta-row">
              <view class="bk-v-meta-left">
                <text class="bk-v-coach">{{item.r.coachName}}</text>
                <text class="bk-v-meta">· {{item.r.dateCn}}</text>
                <text class="bk-v-room" wx:if="{{item.r.showRoom}}"> · {{item.r.room}}</text>
                <text class="bk-v-deadline bk-v-deadline-first" wx:if="{{item.r.autoCancelText}}">{{item.r.autoCancelText}}</text>
                <text class="bk-v-deadline" wx:if="{{item.r.showDeadline}}">截止取消：{{item.r.cancelDeadlineText}}</text>
              </view>
            </view>
          </view>
          <view class="bk-v-foot">
            <view class="bk-v-seat">
              <block wx:if="{{item.r.bookBtnType === 'booked' && item.r.showTime && item.current_bookings !== undefined && item.current_bookings !== null && item.max_bookings > 0}}">
                <view class="bk-v-seat-tt">
                  <text class="bk-v-seat-txt">你已锁定 · {{item.current_bookings}} / {{item.max_bookings}} 席</text>
                  <text class="bk-v-min-cap" wx:if="{{item.r.showMinCapacity}}">{{item.r.minCapacity}}</text>
                </view>
                <view class="bk-v-seat-bar"><view class="bk-v-seat-bar-fill" style="width: {{item.current_bookings / item.max_bookings * 100 > 100 ? 100 : item.current_bookings / item.max_bookings * 100}}%;"></view></view>
              </block>
              <block wx:elif="{{item.r.bookBtnType === 'not_open'}}">
                <view class="bk-v-seat-tt">
                  <text class="bk-v-seat-txt bk-v-seat-dim">{{item.r.openGrab ? '' : '即将开放'}}<text class="bk-v-grab" wx:if="{{item.r.openGrab}}">{{item.r.openGrab}}</text>{{item.r.openGrab ? ' 开抢' : ''}}</text>
                  <text class="bk-v-min-cap" wx:if="{{item.r.showMinCapacity}}">{{item.r.minCapacity}}</text>
                </view>
              </block>
              <block wx:elif="{{item.r.bookBtnType === 'done' || item.r.bookBtnType === 'ended' || item.r.bookBtnType === 'cancelled'}}">
                <view class="bk-v-seat-tt">
                  <text class="bk-v-seat-txt bk-v-seat-dim">{{item.r.bookBtnType === 'done' ? '已登场' : (item.r.bookBtnType === 'cancelled' ? '已取消' : '已结束')}}</text>
                  <text class="bk-v-min-cap" wx:if="{{item.r.showMinCapacity}}">{{item.r.minCapacity}}</text>
                </view>
              </block>
              <block wx:elif="{{item.r.showTime && item.current_bookings !== undefined && item.current_bookings !== null && item.max_bookings > 0}}">
                <view class="bk-v-seat-tt">
                  <text class="bk-v-seat-txt" wx:if="{{item.status === 'full'}}">已满 {{item.current_bookings}} / {{item.max_bookings}} 席</text>
                  <text class="bk-v-seat-txt" wx:else>仅剩 <text class="bk-v-seat-low {{item.max_bookings - item.current_bookings <= 0 ? 'zero' : ''}}">{{item.max_bookings - item.current_bookings}}</text> / {{item.max_bookings}} 席</text>
                  <text class="bk-v-min-cap" wx:if="{{item.r.showMinCapacity}}">{{item.r.minCapacity}}</text>
                </view>
                <view class="bk-v-seat-bar"><view class="bk-v-seat-bar-fill {{item.status === 'full' ? 'full' : ''}}" style="width: {{item.current_bookings / item.max_bookings * 100 > 100 ? 100 : item.current_bookings / item.max_bookings * 100}}%;"></view></view>
              </block>
            </view>
            <view class="bk-v-btn {{item.r.bookBtnType}}" data-course="{{item}}" data-action="{{item.r.bookBtnType === 'full' ? 'waitlist' : ''}}" catchtap="onBookCourse">
              <text>{{item.r.bookBtnType === 'book' ? t.btnBook : item.r.bookBtnType === 'not_open' ? '未开放预约' : item.r.bookBtnType === 'booked' ? t.btnBooked : item.r.bookBtnType === 'full' ? t.btnWaitlist : item.r.bookBtnType === 'waitlisted' ? t.btnWaitlisted : item.r.bookBtnType === 'done' ? t.btnDone : (item.r.bookBtnType === 'ended' || item.r.bookBtnType === 'ongoing') ? t.btnEnded : item.r.bookBtnText}}</text>
            </view>
          </view>
        </view>
      </block>

      <!-- 纸上舞台：明日戏单 -->
      <block wx:if="{{skinId === 'paper' && tomorrowShows && tomorrowShows.count > 0}}">
        <view class="bkp-tomorrow" bindtap="onGoTomorrow">
          <text>明日戏单 · {{tomorrowShows.count}} 场{{tomorrowShows.names ? '：' + tomorrowShows.names : ''}}</text>
          <text class="bkp-tm-arrow">→</text>
        </view>
      </block>

      <view class="list-bottom-safe"></view>
      <view class="booking-disclaimer">成人零基础・舞蹈健身服务</view>
      </view>
    </scroll-view>

    <!-- 骨架屏加载 -->
    <view class="skeleton-list" wx:if="{{loading}}">
      <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="sk-accent-bar"></view>
        <view class="sk-left">
          <view class="sk-avatar"></view>
          <view class="sk-name"></view>
        </view>
        <view class="sk-right">
          <view class="sk-btn"></view>
          <view class="sk-time"></view>
          <view class="sk-title"></view>
          <view class="sk-tag"></view>
          <view class="sk-room"></view>
          <view class="sk-deadline"></view>
          <view class="sk-meta">
            <view class="sk-capacity"></view>
            <view class="sk-avatars">
              <view class="sk-small-avatar" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <empty-state
      wx:if="{{courses.length === 0 && !loading}}"
      text="暂无场次安排"
      hint="试试切换门店或日期">
    </empty-state>
    <view class="booking-disclaimer" wx:if="{{courses.length === 0 && !loading}}">成人零基础・舞蹈健身服务</view>

<block wx:if="{{skinId === 'classic'}}">
<view class="modal-mask" wx:if="{{showStoreModal}}" bindtap="onCloseStoreModal">
  <view class="modal-content" catchtap="onModalTap">
    <view class="modal-title-text">选择门店</view>
    <view class="modal-subtitle">切换门店后将重新加载课程</view>
    <view class="store-list">
      <view class="store-opt {{currentStore && currentStore._id === item._id ? 'active' : ''}}" wx:for="{{storeList}}" wx:key="_id" data-store="{{item}}" bindtap="onSelectStore">
        <view class="store-opt-left">
          <text class="store-opt-name">{{item.name}}</text>
          <text class="store-opt-addr" wx:if="{{item.address}}">{{item.address}}</text>
        </view>
        <view class="store-opt-check" wx:if="{{currentStore && currentStore._id === item._id}}"></view>
      </view>
    </view>
    <view class="modal-close-btn" bindtap="onCloseStoreModal">关闭</view>
  </view>
</view>
</block>

<!-- 纸上舞台 / VOLT：门店选择器 -->
<block wx:if="{{skinId !== 'classic'}}">
  <view class="bk-store-mask {{skinId === 'volt' ? 'bk-store-mask-volt' : ''}}" wx:if="{{showStoreModal}}" bindtap="onCloseStoreModal">
    <view class="bk-store-sheet" catchtap="onModalTap">
      <view class="bk-st-handle"></view>
      <view class="bk-st-head">
        <text class="bk-st-title">选择门店</text>
        <text class="bk-st-sub">切换门店后将重新加载课程</text>
      </view>
      <view class="bk-st-list">
        <view class="bk-st-opt {{currentStore && currentStore._id === item._id ? 'on' : ''}}" wx:for="{{storeList}}" wx:key="_id" data-store="{{item}}" bindtap="onSelectStore">
          <view class="bk-st-opt-main">
            <text class="bk-st-opt-name">{{item.name}}</text>
            <text class="bk-st-opt-addr" wx:if="{{item.address}}">{{item.address}}</text>
          </view>
          <text class="bk-st-opt-check" wx:if="{{currentStore && currentStore._id === item._id}}">{{skinId === 'paper' ? '使用中' : 'ON'}}</text>
        </view>
      </view>
      <view class="bk-st-close" bindtap="onCloseStoreModal">关闭</view>
    </view>
  </view>
</block>

<block wx:if="{{skinId === 'classic'}}">
<view class="modal-mask" wx:if="{{showBookingModal}}" bindtap="onCancelBookingModal">
  <view class="modal-content modal-confirm" catchtap="onModalTap">
    <view class="booking-confirm-icon-wrap">
      <view class="booking-confirm-icon"></view>
    </view>
    <view class="modal-title-text">确认预约</view>
    <text class="modal-body-text">{{bookingModalText}}</text>
    <view class="modal-actions">
      <view class="modal-btn-outline" bindtap="onCancelBookingModal">取消</view>
      <view class="modal-btn-primary" bindtap="onConfirmBookingModal">确认预约</view>
    </view>
  </view>
</view>
</block>

<!-- 纸上舞台 / VOLT：预约确认 -->
<block wx:if="{{skinId !== 'classic'}}">
  <view class="bk-cfm-mask {{skinId === 'volt' ? 'bk-cfm-mask-volt' : ''}}" wx:if="{{showBookingModal}}" bindtap="onCancelBookingModal">
    <view class="bk-cfm-card" catchtap="onModalTap">
      <view class="bk-cfm-handle" wx:if="{{skinId === 'volt'}}"></view>
      <view class="bk-cfm-seal" wx:if="{{skinId === 'paper'}}">栖</view>
      <text class="bk-cfm-kicker" wx:if="{{skinId === 'paper'}}">BOOKING CONFIRMED</text>
      <text class="bk-cfm-title">确认预约<text class="bk-cfm-q" wx:if="{{skinId === 'volt'}}">?</text></text>
      <view class="bk-cfm-line"></view>
      <block wx:if="{{cfmInfo}}">
        <view class="bk-cfm-row"><text>确认预约</text><text class="bk-cfm-strong">「{{cfmInfo.name}}」</text></view>
        <view class="bk-cfm-row"><text>教练：{{cfmInfo.coach}}</text></view>
        <view class="bk-cfm-row"><text>{{cfmInfo.date}} {{cfmInfo.weekDay}} {{cfmInfo.time}}</text></view>
        <view class="bk-cfm-row"><text class="bk-cfm-hl">{{cfmInfo.deductText}}</text></view>
      </block>
      <text class="bk-cfm-body" wx:else>{{bookingModalText}}</text>
      <view class="bk-cfm-actions">
        <view class="bk-cfm-cancel" bindtap="onCancelBookingModal">取消</view>
        <view class="bk-cfm-ok" bindtap="onConfirmBookingModal">{{skinId === 'paper' ? '确认预约' : '立即锁定'}}</view>
      </view>
    </view>
  </view>
</block>

<view class="modal-mask" wx:if="{{showActivateModal}}" bindtap="onCloseActivateModal">
  <view class="modal-content modal-confirm" catchtap="onModalTap">
    <view class="booking-confirm-icon-wrap activate-icon-wrap">
      <view class="activate-icon"></view>
    </view>
    <view class="modal-title-text">套餐激活提醒</view>
    <view class="modal-body-text">您有待激活的套餐，激活后即可预约课程。</view>
    <view class="modal-actions">
      <view class="modal-btn-outline" bindtap="onCancelActivate">暂不激活</view>
      <view class="modal-btn-primary" bindtap="onConfirmActivate">立即激活</view>
    </view>
  </view>
</view>

<view class="modal-mask" wx:if="{{showLimitModal}}" bindtap="onCloseLimitModal">
  <view class="modal-content modal-confirm" catchtap="onModalTap">
    <view class="booking-confirm-icon-wrap limit-icon-wrap">
      <view class="limit-icon"></view>
    </view>
    <view class="modal-title-text">预约提醒</view>
    <view class="modal-body-text">{{limitModalText}}</view>
    <view class="modal-actions modal-actions-single">
      <view class="modal-btn-primary" bindtap="onCloseLimitModal">好的</view>
    </view>
  </view>
</view>

<!-- 加入候补队列：classic 走原弹窗 -->
<view class="modal-mask" wx:if="{{showWaitlistModal && skinId === 'classic'}}" bindtap="onCancelWaitlist">
  <view class="modal-content modal-confirm" catchtap="onModalTap">
    <view class="booking-confirm-icon-wrap waitlist-icon-wrap">
      <view class="waitlist-icon"></view>
    </view>
    <view class="modal-title-text">加入候补队列</view>
    <text class="modal-body-text">{{waitlistModalText}}</text>
    <view class="modal-actions">
      <view class="modal-btn-outline" bindtap="onCancelWaitlist">取消</view>
      <view class="modal-btn-primary" bindtap="onConfirmWaitlist">确认候补</view>
    </view>
  </view>
</view>

<!-- 加入候补队列（paper / volt）：与课程详情页同款皮肤统一弹窗 -->
<view class="bk-cfm-mask {{skinId === 'volt' ? 'bk-cfm-mask-volt' : ''}}" wx:if="{{showWaitlistModal && skinId !== 'classic'}}" bindtap="onCancelWaitlist">
  <view class="bk-cfm-card" catchtap="onModalTap">
    <view class="bk-cfm-handle" wx:if="{{skinId === 'volt'}}"></view>
    <view class="bk-cfm-seal" wx:if="{{skinId === 'paper'}}">栖</view>
    <text class="bk-cfm-kicker" wx:if="{{skinId === 'paper'}}">BOOKING NOTICE</text>
    <text class="bk-cfm-title">加入候补队列</text>
    <view class="bk-cfm-line"></view>
    <text class="bk-cfm-body">{{waitlistModalText}}</text>
    <view class="bk-cfm-actions">
      <view class="bk-cfm-cancel" bindtap="onCancelWaitlist">取消</view>
      <view class="bk-cfm-ok" bindtap="onConfirmWaitlist">确认候补</view>
    </view>
  </view>
</view>

<view class="modal-mask" wx:if="{{showStorePicker}}" bindtap="onCloseStorePicker">
  <view class="modal-content" catchtap="onModalTap">
    <view class="modal-title-text">{{storePickerTitle}}</view>
    <view class="store-list">
      <view class="store-opt {{selectedStoreId === item._id ? 'active' : ''}}" wx:for="{{storeList}}" wx:key="_id" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="onStoreSelect">
        <text class="store-opt-name">{{item.name}}</text>
        <text class="store-opt-dist" wx:if="{{item.distance !== undefined}}">{{item.distance}}km</text>
      </view>
    </view>
    <view class="btn-primary" bindtap="onStoreConfirm" disabled="{{!selectedStoreId}}">确认</view>
  </view>
</view>

<!-- 时间卡限额已满，确认激活次卡弹窗 -->
<view class="modal-mask" wx:if="{{showCountCardModal}}" bindtap="onCloseCountCardModal">
  <view class="modal-content modal-confirm" catchtap="onModalTap">
    <view class="booking-confirm-icon-wrap countcard-icon-wrap">
      <view class="countcard-icon"></view>
    </view>
    <view class="modal-title-text">时间卡次数已用完</view>
    <view class="modal-body-text">{{countCardModalText}}</view>
    <view class="modal-actions">
      <view class="modal-btn-outline" bindtap="onCancelCountCard">取消</view>
      <view class="modal-btn-primary" bindtap="onConfirmCountCard">激活并预约</view>
    </view>
  </view>
</view>
</view>

<!-- 微信授权登录弹窗 -->
<login-modal visible="{{showLoginModal}}" bind:close="onLoginModalClose" bind:success="onLoginSuccess"></login-modal>
<update-modal />
<skin-success props="{{skinSuccess}}" bind:ok="onSkinSuccessOk" />
<skin-notice props="{{skinNotice}}" bind:ok="onSkinNoticeOk" />
