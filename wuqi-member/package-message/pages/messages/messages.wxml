<view class="msg-page skin-root skin-{{skinId}}">
  <!-- 页头：标题 + 一键已读 -->
  <view class="msg-header">
    <text class="msg-header-title">我的消息</text>
    <view class="msg-markall {{unreadCount === 0 ? 'msg-markall-disabled' : ''}}" bindtap="onMarkAllRead">
      <text class="msg-markall-text">{{markAllText}}</text>
      <view class="msg-markall-badge" wx:if="{{unreadCount > 0}}">
        <text class="msg-markall-badge-num">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
      </view>
    </view>
  </view>

  <!-- 筛选 Chip：全部 / 提醒 / 通知 / 公告 -->
  <view class="msg-chips">
    <view
      wx:for="{{categories}}"
      wx:key="key"
      class="msg-chip {{category === item.key ? 'msg-chip-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onCategoryTap"
    >
      <text class="msg-chip-text">{{item.label}}</text>
    </view>
  </view>

  <!-- 消息列表 -->
  <view class="msg-list" wx:if="{{list.length > 0}}">
    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="msg-item {{item.unread ? 'msg-item-unread' : ''}} {{expandedId === item._id ? 'msg-item-open' : ''}}"
      data-index="{{index}}"
      bindtap="onItemTap"
    >
      <view class="msg-item-head">
        <view class="msg-type-dot" style="background: {{item.color}};"></view>
        <text class="msg-type-name" style="color: {{item.color}};">{{item.type_name}}</text>
        <!-- paper 未读：朱红斜章「未启」 -->
        <view class="msg-stamp" wx:if="{{item.unread && skinId === 'paper'}}">
          <text class="msg-stamp-text">未启</text>
        </view>
        <text class="msg-time">{{item.timeText}}</text>
      </view>
      <view class="msg-title-row">
        <!-- classic 未读：红点 -->
        <view class="msg-red-dot" wx:if="{{item.unread && skinId === 'classic'}}"></view>
        <text class="msg-title {{item.unread ? 'msg-title-unread' : ''}}">{{item.title}}</text>
      </view>
      <text class="msg-content">{{item.content}}</text>
    </view>

    <view class="msg-list-footer" wx:if="{{!hasMore && list.length > 0}}">
      <text class="msg-list-footer-text">— 没有更多了 —</text>
    </view>
    <view class="msg-list-loading" wx:if="{{loading && !refresherTriggered}}">
      <text class="msg-list-loading-text">加载中…</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="msg-empty" wx:if="{{!loading && list.length === 0}}">
    <view class="msg-empty-icon">
      <text class="msg-empty-glyph">✉</text>
    </view>
    <text class="msg-empty-text">{{category === 'announcement' ? '暂无公告' : '暂无消息'}}</text>
    <text class="msg-empty-sub">新的消息会出现在这里</text>
  </view>
</view>
