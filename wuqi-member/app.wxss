.bk-volt-card { position: relative; margin: 0 30rpx 40rpx; background: #FFFFFF; border: 4rpx solid #111310; border-radius: 36rpx; overflow: visible; box-shadow: 10rpx 10rpx 0 #111310; transition: transform 150ms cubic-bezier(0.34, 1.56, 0.64, 1); }
.bk-volt-card:active { transform: scale(0.98) rotate(-0.5deg); }
.bk-ghost { position: absolute; top: 0; right: 24rpx; font-size: 116rpx; font-weight: 900; line-height: 1; color: transparent; -webkit-text-stroke: 2.6rpx #E3E1D6; pointer-events: none; font-family: 'AntonV', 'Anton', sans-serif; }
.bk-v-top { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 36rpx; border-bottom: 3rpx dashed #DCDAD0; }
.bk-v-tag { font-size: 23rpx; font-weight: 700; border: 3rpx solid #111310; border-radius: 999rpx; padding: 10rpx 26rpx; color: #111310; background: #FFFFFF; }
.bk-v-tag.bk-v-live { background: #111310; color: #D7FF3B; display: inline-flex; align-items: center; gap: 10rpx; font-family: 'AntonV', 'Anton', sans-serif; letter-spacing: 0.1em; }
.bk-v-live-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #D7FF3B; animation: bk-v-blink 1.2s infinite; }
@keyframes bk-v-blink { 50% { opacity: 0.25; } }
.bk-v-time { display: block; margin-right: -12rpx; font-size: 46rpx; font-weight: 700; letter-spacing: -0.01em; color: #111310; font-family: 'GroteskV', sans-serif; white-space: nowrap; line-height: 1.2; position: relative; z-index: 2; }
.bk-v-wd { font-size: 46rpx; font-weight: 900; color: #111310; margin-right: 14rpx; }
.bk-v-time-end { font-size: 22rpx; color: #9C9D93; font-weight: 500; margin-left: 10rpx; }
.bk-v-body { padding: 30rpx 36rpx 12rpx; }
.bk-v-name { display: block; font-size: 46rpx; font-weight: 900; color: #111310; }
.bk-v-meta-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 6rpx; }
.bk-v-meta { display: inline; font-size: 24rpx; color: #111310; }
.bk-v-room { display: inline; font-size: 24rpx; color: #9C9D93; }
.bk-v-deadline { display: block; font-size: 20rpx; color: #9C9D93; line-height: 1.6; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bk-v-deadline-first { margin-top: 16rpx; }
/* 席位行：仅剩X/XX席 在左、最低X人成班 在右（右缘与进度条右缘对齐） */
.bk-v-seat-tt { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.bk-v-foot { display: flex; justify-content: flex-end; align-items: center; gap: 28rpx; padding: 24rpx 36rpx 32rpx; position: relative; z-index: 2; }
.bk-v-seat { flex: 1; min-width: 0; }
.bk-v-seat-txt { font-size: 23rpx; font-weight: 800; color: #111310; letter-spacing: 0.02em; font-family: 'GroteskV', sans-serif; }
.bk-v-seat-bar { height: 6rpx; margin-top: 10rpx; background: #ECEAE2; border: 1rpx solid #DCDAD0; border-radius: 99rpx; overflow: hidden; }
.bk-v-seat-bar-fill { height: 100%; background: #111310; border-radius: 99rpx; }
.bk-v-seat-bar-fill.full { background: #77786F; }
.bk-v-seat-low { display: inline-block; background: #D7FF3B; color: #111310; padding: 0 8rpx; border-radius: 6rpx; font-weight: 900; margin: 0 2rpx; }
.bk-v-seat-low.zero { background: #DCDAD0; color: #77786F; }
.bk-v-min-cap { flex-shrink: 0; font-size: 20rpx; color: #9C9D93; }
.bk-v-btn { height: 72rpx; padding: 0 40rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; font-size: 25rpx; font-weight: 800; letter-spacing: 0.08em; border: 3rpx solid #111310; flex-shrink: 0; }
.bk-v-btn.book { background: #111310; color: #D7FF3B; }
.bk-v-btn.booked { background: #D7FF3B; color: #111310; }
.bk-v-btn.waitlisted, .bk-v-btn.full { background: transparent; color: #111310; }
.bk-v-btn.done { background: #ECEAE2; color: #9C9D93; border-color: #DCDAD0; }
.bk-v-btn.ongoing, .bk-v-btn.ended, .bk-v-btn.cancelled, .bk-v-btn.cannot_book, .bk-v-btn.not_open { background: transparent; color: #9C9D93; border-color: #DCDAD0; }
.bk-v-locked { position: absolute; top: -16rpx; left: 24rpx; z-index: 3; display: inline-flex; align-items: center; background: #D7FF3B; color: #111310; border: 3rpx solid #111310; border-radius: 12rpx; padding: 4rpx 18rpx; font-family: 'AntonV', 'Anton', sans-serif; font-size: 22rpx; letter-spacing: 0.12em; line-height: 1.4; }

/* 把手短横：抽屉时代残留，居中浮卡上隐藏 */
.bk-cfm-handle { display: none !important; }
