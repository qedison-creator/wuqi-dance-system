page {
  background: #FBFAF8;
  color: #2A2122;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  box-sizing: border-box;
}

/* 全局隐藏页面级滚动条（右侧滑动指示器） */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

:root {
  --clr-primary: #D4786E;
  --clr-primary-deep: #C05D53;
  --clr-primary-light: #EBA89F;
  --clr-primary-wash: #FDF2EF;

  --clr-secondary: #5D9B9B;
  --clr-secondary-wash: #EEF5F4;

  --clr-accent: #B89CDA;

  --clr-bg: #FBFAF8;
  --clr-card: #FFFFFF;
  --clr-elevated: #FAF9F7;

  --clr-text: #2A2122;
  --clr-text-sub: #6B5D5E;
  --clr-text-hint: #948284;
  --clr-border: #F0E8E5;

  --clr-gold: #E8985E;
  --clr-mint: #7EB8A0;
  --clr-blue: #8B9DC3;
  --clr-lavender: #B89CDA;

  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 36rpx;

  --shadow-sm: 0 2rpx 12rpx rgba(42,33,34,0.04);
  --shadow-md: 0 4rpx 24rpx rgba(42,33,34,0.06);
  --shadow-lg: 0 8rpx 40rpx rgba(42,33,34,0.09);
  --shadow-float: 0 4rpx 32rpx rgba(42,33,34,0.10);

  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-smooth: cubic-bezier(0.4, 0, 0.2, 1);
  --dur-fast: 150ms;
  --dur-normal: 280ms;
  --dur-slow: 400ms;
}

.btn-primary {
  background: linear-gradient(135deg, #D4786E, #C05D53);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  min-height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  text-align: center;
  border: none;
  width: 100%;
  box-shadow: 0 6rpx 24rpx rgba(212,120,110,0.3);
  letter-spacing: 1rpx;
  transition: all 150ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.btn-primary::after { border: none; }

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 3rpx 12rpx rgba(212,120,110,0.2);
}

.btn-outline {
  background: transparent;
  color: #D4786E;
  font-size: 28rpx;
  font-weight: 600;
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: 48rpx;
  border: 2rpx solid #D4786E;
  text-align: center;
  width: 100%;
  letter-spacing: 1rpx;
  transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);
}

.btn-outline::after { border: none; }

.btn-outline:active {
  background: rgba(212,120,110,0.08);
  transform: scale(0.98);
}

.tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  letter-spacing: 0.5rpx;
  display: inline-flex;
  align-items: center;
}

.tag-rose {
  color: #D4786E;
  background: rgba(212,120,110,0.10);
}

.tag-teal {
  color: #5D9B9B;
  background: rgba(93,155,155,0.10);
}

.tag-purple {
  color: #8B7BF7;
  background: rgba(139,123,247,0.10);
}

.tag-gold {
  color: #E8985E;
  background: rgba(232,152,94,0.10);
}

.tag-mint {
  color: #7EB8A0;
  background: rgba(126,184,160,0.10);
}

.tag-gray {
  color: #948284;
  background: rgba(148,130,132,0.10);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 0 20rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
}

.section-dot {
  width: 6rpx;
  height: 26rpx;
  border-radius: 3rpx;
  background: #D4786E;
  margin-right: 14rpx;
}

.section-title {
  font-size: 34rpx;
  color: #2A2122;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.section-more {
  font-size: 24rpx;
  color: #D4786E;
  font-weight: 500;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(42,33,34,0.55);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 150ms cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  background: #FFFFFF;
  border-radius: 36rpx;
  width: 86%;
  max-width: 620rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 12rpx 60rpx rgba(42,33,34,0.15);
  animation: modalIn 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modalIn {
  from { opacity: 0; transform: scale(0.92) translateY(30rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(212,120,110,0.08), rgba(232,152,94,0.06));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-icon::after {
  content: '';
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid rgba(212,120,110,0.25);
  border-radius: 50%;
}

.empty-text {
  font-size: 28rpx;
  color: #948284;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.empty-hint {
  font-size: 24rpx;
  color: #B5A2A4;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(212,120,110,0.12);
  border-top-color: #D4786E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-area text {
  font-size: 24rpx;
  color: #948284;
  margin-top: 16rpx;
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@keyframes rippleOut {
  0% { transform: scale(0); opacity: 1; }
  100% { transform: scale(4); opacity: 0; }
}

/* ==================== 皮肤切换（classic 原样 / paper / volt） ====================
   页面最外层节点挂 .skin-root.skin-{id}；
   核心页（首页/约课/课程详情/教练详情/画廊/我的）的 paper、volt 版本为独立节点块；
   以下令牌与通用覆盖供次级页「换色不换布局」使用。classic 不引入任何覆盖。 */

/* ---------- 皮肤令牌 ---------- */
.skin-root.skin-paper {
  --sk-bg: #F5F1E8;
  --sk-card: #FCFAF4;
  --sk-ink: #221D15;
  --sk-sub: #6C6353;
  --sk-hint: #A79D89;
  --sk-line: #DFD6C2;
  --sk-acc: #B93A26;
  --sk-acc-deep: #9E3322;
  --sk-gold: #A0802E;
  --sk-radius: 12rpx;
  --sk-btn-radius: 6rpx;
  --sk-btn-fg: #FCF7EE;
  --sk-serif: "Noto Serif SC", "Songti SC", "STSong", serif;
  background: var(--sk-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

.skin-root.skin-volt {
  --sk-bg: #F2F1ED;
  --sk-card: #FFFFFF;
  --sk-ink: #111310;
  --sk-sub: #77786F;
  --sk-hint: #9C9D93;
  --sk-line: #DCDAD0;
  --sk-acc: #111310;
  --sk-acc-fg: #D7FF3B;
  --sk-volt: #D7FF3B;
  --sk-radius: 28rpx;
  --sk-btn-radius: 999rpx;
  --sk-btn-fg: #D7FF3B;
  background: var(--sk-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ---------- 次级页通用覆盖（换色不换布局，classic 零影响） ---------- */
/* 纸上舞台 */
.skin-paper .btn-primary {
  background: var(--sk-acc);
  border-radius: var(--sk-btn-radius);
  box-shadow: 2rpx 3rpx 0 rgba(34, 29, 21, 0.18);
  font-family: var(--sk-serif);
}
.skin-paper .btn-outline {
  border: 2rpx solid var(--sk-ink);
  color: var(--sk-ink);
  border-radius: var(--sk-btn-radius);
}
.skin-paper .section-dot { background: var(--sk-acc); border-radius: 2rpx; }
.skin-paper .section-title { font-family: var(--sk-serif); letter-spacing: 0.05em; }
.skin-paper .modal-content { border-radius: 8rpx; border: 2rpx solid var(--sk-line); }
.skin-paper .tag { border-radius: 4rpx; }
.skin-paper .empty-text { font-family: var(--sk-serif); }

/* VOLT 舞力场 */
.skin-volt .btn-primary {
  background: var(--sk-ink);
  color: var(--sk-acc-fg);
  border-radius: var(--sk-btn-radius);
  font-weight: 800;
  box-shadow: none;
}
.skin-volt .btn-outline {
  border: 3rpx solid var(--sk-ink);
  color: var(--sk-ink);
  border-radius: var(--sk-btn-radius);
  font-weight: 800;
}
.skin-volt .section-dot { background: var(--sk-volt); border-radius: 4rpx; box-shadow: 2rpx 2rpx 0 var(--sk-ink); }
.skin-volt .section-title { letter-spacing: 0.02em; font-weight: 900; }
.skin-volt .modal-content { border-radius: 36rpx; border: 3rpx solid var(--sk-ink); }
.skin-volt .tag { border: 2rpx solid var(--sk-ink); border-radius: 999rpx; background: var(--sk-card); color: var(--sk-ink); }
.skin-volt .loading-spinner { border-color: var(--sk-line); border-top-color: var(--sk-ink); }

/* ==================== 皮肤弹窗全局化 skin-modal-elevate ====================
   （与页面级 skin 文件中的同类规则重复定义，放置于全局以确保任何加载链路下都生效） */

/* ---------- 纸上舞台：入场券 ---------- */
.ssq-mask { position: fixed !important; left: 0; top: 0; right: 0; bottom: 0; z-index: 99990 !important; background: rgba(34, 29, 21, 0.45) !important; display: flex !important; align-items: flex-end !important; }
.ssq-paper { width: 100% !important; background: #FCFAF4 !important; border-radius: 20rpx 20rpx 0 0; border-top: 4rpx solid #DFD6C2; padding: 36rpx 36rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; animation: sk-rise-in 400ms cubic-bezier(0.22, 1, 0.36, 1) both; }
.ssq-head { display: flex; justify-content: space-between; align-items: baseline; }
.ssq-title { font-family: 'Noto Serif SC', serif; font-size: 38rpx; font-weight: 900; color: #221D15; letter-spacing: 0.2em; }
.ssq-en { font-size: 19rpx; letter-spacing: 0.3em; color: #B93A26; font-weight: 700; }
.ssq-body { display: flex; gap: 30rpx; align-items: center; margin-top: 26rpx; }
.ssq-qr { width: 240rpx; height: 240rpx; flex-shrink: 0; background: #FFFFFF; border: 2rpx solid #DFD6C2; padding: 14rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; }
.ssq-canvas { width: 210rpx; height: 210rpx; }
.ssq-meta { flex: 1; min-width: 0; }
.ssq-name { display: block; font-family: 'Noto Serif SC', serif; font-size: 30rpx; font-weight: 700; color: #221D15; }
.ssq-code { display: block; margin-top: 8rpx; font-family: 'Noto Serif SC', serif; font-size: 34rpx; font-weight: 900; letter-spacing: 0.12em; color: #221D15; }
.ssq-refresh { display: block; margin-top: 12rpx; font-size: 20rpx; color: #B93A26; }
.ssq-note-row { display: flex; justify-content: space-between; margin-top: 26rpx; padding-top: 20rpx; border-top: 2rpx dashed #DFD6C2; font-size: 20rpx; color: #6C6353; }
.ssq-status { margin-top: 16rpx; text-align: center; }

/* ---------- VOLT：入场 PASS ---------- */
.svq-mask { position: fixed !important; left: 0; top: 0; right: 0; bottom: 0; z-index: 99990 !important; background: rgba(17, 19, 16, 0.55) !important; display: flex !important; align-items: flex-end !important; }
.svq-card { width: 100% !important; background: #F2F1ED !important; border-radius: 32rpx 32rpx 0 0; border-top: 4rpx solid #111310; padding: 36rpx 36rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; animation: sk-rise-in 400ms cubic-bezier(0.22, 1, 0.36, 1) both; }
.svq-head { display: flex; justify-content: space-between; align-items: baseline; }
.svq-title { font-family: 'AntonV', 'Anton', sans-serif; font-weight: 400; font-size: 42rpx; color: #111310; letter-spacing: 0.04em; }
.svq-en { font-size: 19rpx; letter-spacing: 0.25em; color: #77786F; font-weight: 700; }
.svq-ticket { margin-top: 24rpx; background: #D7FF3B !important; border: 3rpx solid #111310; border-radius: 24rpx; padding: 24rpx; box-shadow: 5rpx 5rpx 0 #111310; }
.svq-ticket-top { display: flex; align-items: center; }
.svq-t-name { font-size: 24rpx; font-weight: 900; color: #111310; letter-spacing: 0.15em; }
.svq-body { display: flex !important; gap: 28rpx !important; align-items: center !important; margin-top: 18rpx !important; background: #FFFFFF !important; border: 2rpx solid #111310; border-radius: 16rpx; padding: 20rpx; }
.svq-qr { width: 220rpx; height: 220rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.svq-canvas { width: 210rpx; height: 210rpx; }
.svq-meta { flex: 1; min-width: 0; }
.svq-name { display: block; font-size: 28rpx; font-weight: 900; color: #111310; }
.svq-code { display: block; margin-top: 8rpx; font-size: 30rpx; font-weight: 900; letter-spacing: 0.1em; color: #111310; }
.svq-refresh { display: block; margin-top: 10rpx; font-size: 19rpx; font-weight: 700; color: #77786F; }
.svq-eq { display: flex !important; align-items: flex-end !important; justify-content: center; gap: 8rpx; height: 40rpx; margin-top: 22rpx; }
.svq-eq-b { width: 8rpx; border-radius: 4rpx; background: #111310; animation: svq-eq 0.9s ease-in-out infinite alternate; }
@keyframes svq-eq { from { height: 10rpx; } to { height: 40rpx; } }
.svq-bpm { margin-top: 12rpx; text-align: center; font-size: 21rpx; font-weight: 700; letter-spacing: 0.2em; color: #111310; }
.svq-bpm-v { background: #D7FF3B; border: 2rpx solid #111310; border-radius: 8rpx; padding: 2rpx 12rpx; }
.svq-note-row { margin-top: 22rpx; font-size: 20rpx; color: #77786F; display: flex; justify-content: center; }
.svq-status { margin-top: 14rpx; text-align: center; }

/* ---------- 约课确认（paper/volt） ---------- */
.bk-cfm-mask { position: fixed !important; left: 0; top: 0; right: 0; bottom: 0; z-index: 99980; background: rgba(34, 29, 21, 0.45) !important; display: flex; align-items: center; justify-content: center; }
.bk-cfm-mask-volt { background: rgba(17, 19, 16, 0.55) !important; }
.bk-cfm-card { width: 580rpx !important; background: #FCFAF4 !important; border: 2rpx solid #DFD6C2; border-radius: 10rpx; padding: 44rpx 40rpx 36rpx; box-sizing: border-box; text-align: center; animation: sk-rise-in 400ms cubic-bezier(0.22, 1, 0.36, 1) both; }
.bk-cfm-kicker { display: block; font-size: 17rpx; letter-spacing: 0.35em; color: #B93A26; font-weight: 700; }
.bk-cfm-title { display: block; margin-top: 12rpx; font-family: 'Noto Serif SC', serif; font-size: 40rpx; font-weight: 900; color: #221D15; letter-spacing: 0.1em; }
.bk-cfm-body { display: block; margin-top: 18rpx; font-size: 24rpx; color: #6C6353; line-height: 1.9; }
.bk-cfm-actions { display: flex; gap: 20rpx; margin-top: 36rpx; }
.bk-cfm-cancel { flex: 1; height: 88rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #221D15; border-radius: 6rpx; font-size: 26rpx; color: #221D15; font-weight: 700; }
.bk-cfm-ok { flex: 1; height: 88rpx; display: flex; align-items: center; justify-content: center; background: #B93A26; color: #FCF7EE; border-radius: 6rpx; font-size: 26rpx; font-weight: 700; letter-spacing: 0.1em; font-family: 'Noto Serif SC', serif; box-shadow: 2rpx 3rpx 0 rgba(34, 29, 21, 0.18); }
.bk-cfm-cancel:active, .bk-cfm-ok:active { transform: scale(0.97); }
.bk-cfm-handle { width: 34rpx; height: 5rpx; border-radius: 3rpx; background: #DCDAD0; margin: 0 auto 18rpx; }
.bk-cfm-mask-volt .bk-cfm-card { width: 580rpx !important; background: #F2F1ED !important; border: 3rpx solid #111310; border-radius: 32rpx; box-shadow: 8rpx 8rpx 0 rgba(17, 19, 16, 0.4); overflow: hidden; padding-top: 30rpx; }
.bk-cfm-mask-volt .bk-cfm-kicker { color: #77786F; letter-spacing: 0.3em; }
.bk-cfm-mask-volt .bk-cfm-title { font-family: -apple-system, sans-serif; font-weight: 900; letter-spacing: 0.02em; }
.bk-cfm-mask-volt .bk-cfm-cancel { border: 3rpx solid #111310; border-radius: 999rpx; font-weight: 800; }
.bk-cfm-mask-volt .bk-cfm-ok { background: #111310; color: #D7FF3B; border-radius: 999rpx; font-weight: 800; font-family: -apple-system, sans-serif; box-shadow: none; }


/* ---------- 皮肤动效 keyframes（组件/页面共用） ---------- */
/* A 盖章 */
@keyframes sk-stamp-in {
  0% { opacity: 0; transform: scale(2.4) rotate(-16deg); }
  55% { opacity: 1; transform: scale(0.9) rotate(-2deg); }
  100% { opacity: 1; transform: scale(1) rotate(-5deg); }
}
/* B 拳入 */
@keyframes sk-punch-in {
  0% { opacity: 0; transform: scale(2.6) rotate(-8deg); filter: blur(8rpx); }
  60% { opacity: 1; filter: blur(0); }
  100% { opacity: 1; transform: scale(1) rotate(-3deg); filter: blur(0); }
}
/* 卡片轻震（拳入伴随） */
@keyframes sk-shake {
  0%, 100% { transform: translate(0, 0); }
  25% { transform: translate(4rpx, -4rpx); }
  50% { transform: translate(-4rpx, 4rpx); }
  75% { transform: translate(4rpx, 4rpx); }
}
/* 纸屑 */
@keyframes sk-confetti-fall {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(420rpx) rotate(260deg); opacity: 0; }
}
/* 列表浮现 */
@keyframes sk-rise-in {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 皮肤：全局加载动画随皮肤变色（loading 态节点在 skin-root 内/外均生效的写法见各页根挂载） */
.skin-paper .loading-spinner { border: 4rpx solid #E2DAC8; border-top-color: #B93A26; }
.skin-volt .loading-spinner { border: 4rpx solid #DCDAD0; border-top-color: #111310; }
.skin-paper .loading-text { color: #A79D89; font-family: var(--sk-serif); }
.skin-volt .loading-text { color: #77786F; font-weight: 700; }

/* ==================== 皮肤：全量残留清理（组件 / 弹窗 / 次级页） skin-audit-1 ==================== */
/* 四个组件（empty-state/login-modal/announce-popup/update-modal）已开启 apply-shared，
   以下覆盖按节点树祖先 .skin-paper/.skin-volt 命中组件内部；色值直接写死不依赖变量继承。 */

/* ---------- 组件：空态 ---------- */
.skin-paper .empty-icon { border-color: #C9BFA8; }
.skin-paper .empty-icon-inner { background: #ECE5D6; }
.skin-paper .empty-action { border-color: #221D15; }
.skin-paper .action-text { color: #221D15; font-family: 'Noto Serif SC', serif; }
.skin-volt .empty-icon { border-color: #DCDAD0; }
.skin-volt .empty-icon-inner { background: #ECEAE2; }
.skin-volt .empty-action { background: #111310; border-radius: 999rpx; }
.skin-volt .empty-action .action-text { color: #D7FF3B; font-weight: 800; }

/* ---------- 组件：登录弹窗 ---------- */
.skin-paper .btn-confirm {
  background: #B93A26;
  border-radius: 6rpx;
  font-family: 'Noto Serif SC', serif;
  letter-spacing: 0.12em;
  box-shadow: 2rpx 3rpx 0 rgba(34, 29, 21, 0.18);
}
.skin-paper .btn-cancel { background: transparent; color: #6C6353; border: 2rpx solid #C9BFA8; border-radius: 6rpx; }
.skin-paper .privacy-link { color: #B93A26; }
.skin-paper .checkbox-icon.checked { background: #B93A26; border-color: #B93A26; }
.skin-volt .btn-confirm {
  background: #111310; color: #D7FF3B;
  border-radius: 999rpx; font-weight: 800; box-shadow: none;
}
.skin-volt .btn-cancel { background: transparent; color: #77786F; border: 3rpx solid #DCDAD0; border-radius: 999rpx; }
.skin-volt .privacy-link { color: #111310; font-weight: 700; }
.skin-volt .checkbox-icon.checked { background: #111310; border-color: #111310; }

