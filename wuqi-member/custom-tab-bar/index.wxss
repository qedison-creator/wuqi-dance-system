.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
  border-top: 1rpx solid #F0E8E5;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-bar-capsule {
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 120rpx;
  padding: 0 60rpx;
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  transition: all 250ms cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #D4786E;
}

.tab-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 250ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-item.active .tab-icon {
  transform: scale(1.1);
}

.ti-shape {
  width: 48rpx;
  height: 48rpx;
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 8rpx;
  box-sizing: border-box;
  transition: all 250ms cubic-bezier(0.4, 0, 0.2, 1);
}

.ti-home {
  width: 40rpx;
  height: 38rpx;
  border: 4rpx solid #948284;
  border-radius: 6rpx 6rpx 0 0;
  border-bottom: none;
  position: relative;
  box-sizing: border-box;
  transform: translateY(-3rpx);
}

.ti-home::after {
  content: '';
  position: absolute;
  bottom: -3rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 4rpx;
  background: #948284;
  border-radius: 2rpx;
}

.tab-item.active .ti-home {
  border-color: #D4786E;
}

.tab-item.active .ti-home::after {
  background: #D4786E;
}

.ti-cal {
  width: 40rpx;
  height: 38rpx;
  border: 4rpx solid #948284;
  border-radius: 6rpx;
  position: relative;
  box-sizing: border-box;
  transform: translateY(0rpx);
}

.ti-cal::before {
  content: '';
  position: absolute;
  top: -6rpx;
  left: -4rpx;
  right: -4rpx;
  height: 6rpx;
  background: #948284;
  border-radius: 3rpx 3rpx 0 0;
}

.ti-cal::after {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #948284;
  box-shadow: 10rpx 0 0 #948284, -10rpx 0 0 #948284;
}

.tab-item.active .ti-cal {
  border-color: #D4786E;
}

.tab-item.active .ti-cal::before {
  background: #D4786E;
}

.tab-item.active .ti-cal::after {
  background: #D4786E;
  box-shadow: 8rpx 0 0 #D4786E, -8rpx 0 0 #D4786E;
}

.ti-user {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #948284;
  border-radius: 50%;
  position: relative;
  box-sizing: border-box;
  transform: translateY(-12rpx);
}

.ti-user::after {
  content: '';
  position: absolute;
  bottom: -24rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 18rpx;
  border: 4rpx solid #948284;
  border-radius: 20rpx 20rpx 0 0;
  border-bottom: none;
  box-sizing: border-box;
}

.tab-item.active .ti-user {
  border-color: #D4786E;
}

.tab-item.active .ti-user::after {
  border-color: #D4786E;
}

.tab-text {
  font-size: 26rpx;
  color: #948284;
  font-weight: 500;
  margin-top: 6rpx;
  transition: color 250ms cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-item.active .tab-text {
  color: #D4786E;
  font-weight: 600;
}


/* ==================== 皮肤 TabBar：点 + 文字 ==================== */
.tb-bar-capsule {
  display: flex; align-items: stretch;
  height: 108rpx; padding: 0 40rpx; box-sizing: border-box;
  width: 100%;
}
.tb-item {
  flex: 1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 8rpx;
  position: relative;
}

/* 纸上舞台 */
.tb-paper .tb-dot {
  width: 10rpx; height: 10rpx;
  border-radius: 2rpx;
  background: transparent;
  transition: background 200ms;
}
.tb-paper .tb-item.active .tb-dot { background: #B93A26; transform: rotate(45deg); }
.tb-paper .tb-text {
  font-family: 'Noto Serif SC', 'Songti SC', serif;
  font-size: 24rpx; letter-spacing: 0.2em;
  color: #A79D89; font-weight: 500;
  transition: color 200ms;
}
.tb-paper .tb-item.active .tb-text { color: #221D15; font-weight: 700; }
.tb-paper.tb-bar-capsule { background: #FCFAF4; }
.tab-bar.skin-paper .tb-paper { background: #FCFAF4; }
.tab-bar.skin-paper { background: #FCFAF4; border-top: 2rpx solid #DFD6C2; }

/* VOLT：原生动画生长方案（wx.createAnimation）
   - 胶囊永远静态停在自己 tab（无过渡，首帧即正确），不做跨页滑动
   - 尺寸变化由 JS 写入的动画数据驱动（见 index.js growPillAnim），不依赖 CSS 动画时钟，
     第二次及以后的切换同样完整播放
   - 外层只负责定位（translateX），内层只负责尺寸（width 74% → 100%），互不干扰 */
.tb-volt-track {
  position: relative;
  flex: 1;
  display: flex;
}
.tb-volt-indicator {
  position: absolute;
  top: 12rpx;
  left: 0;
  width: calc(100% / 3);
  height: 84rpx;
}
/* 内层绝对定位：预置起点为 scaleX(0.72)，onShow 后由原生动画长到 1 */
.tb-volt-indicator-inner {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 999rpx;
  background: #111310;
}
/* 方向锚点（类名由 JS 写入 dir-left / dir-right）：
   往右切 → 锚左边缘、从左向右展开；往左切 → 锚右边缘、从右向左展开 */
.tb-volt-indicator-inner.dir-left {
  transform-origin: left center;
}
.tb-volt-indicator-inner.dir-right {
  left: auto;
  right: 0;
  transform-origin: right center;
}
.tb-volt .tb-item {
  flex: 1;
  position: relative;
  z-index: 1;
  height: 84rpx;
  flex-direction: row; gap: 10rpx;
  align-self: center;
  border-radius: 999rpx;
}
.tb-volt .tb-dot {
  width: 8rpx; height: 8rpx; border-radius: 2rpx;
  background: transparent;
  transition: background-color 180ms ease;
}
.tb-volt .tb-item.active .tb-dot { background: #D7FF3B; }
.tb-volt .tb-text {
  font-size: 24rpx; font-weight: 700; letter-spacing: 0.1em;
  color: #77786F;
  transition: color 180ms ease;
}
.tb-volt .tb-item.active .tb-text { color: #D7FF3B; }
.tab-bar.skin-volt { background: #F2F1ED; border-top: 3rpx solid #111310; }
.tab-bar.skin-volt .tb-bar-capsule { padding: 0 24rpx; }
