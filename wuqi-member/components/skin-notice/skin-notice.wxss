/* 皮肤化状态拦截：三套皮肤各自独立的卡片语言 */
.sn-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 99990;
  background: rgba(42, 33, 34, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sn-mask-volt { background: rgba(17, 19, 16, 0.6); }
.sn-mask-paper { background: rgba(34, 29, 21, 0.42); }

/* ---------- 经典 ---------- */
.sn-classic {
  width: 560rpx;
  max-width: 84vw;
  background: #FBFAF8;
  border-radius: 28rpx;
  padding: 52rpx 44rpx 40rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(42, 33, 34, 0.18);
  animation: sn-fade-up 260ms ease-out both;
}
.sn-classic-icon {
  width: 76rpx; height: 76rpx;
  margin: 0 auto 22rpx;
  border-radius: 50%;
  background: #F7E8E6;
  color: #D4786E;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 76rpx;
}
.sn-classic-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #2A2122;
}
.sn-classic-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #8B7E6A;
}
.sn-classic-btn {
  margin-top: 36rpx;
  height: 82rpx;
  border-radius: 999rpx;
  background: #D4786E;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sn-classic-btn:active { transform: scale(0.97); }

/* ---------- 纸上舞台 ---------- */
.sn-paper {
  width: 560rpx;
  background: #FCFAF4;
  border: 2rpx solid #DFD6C2;
  border-radius: 10rpx;
  padding: 88rpx 40rpx 40rpx;
  text-align: center;
  box-sizing: border-box;
  position: relative;
  animation: sn-rise-in 360ms cubic-bezier(0.22, 1, 0.36, 1) both;
}
.sn-paper-seal {
  position: absolute;
  top: -44rpx; left: 50%;
  margin-left: -66rpx;
  width: 132rpx; height: 132rpx;
  background: #B93A26;
  color: #FCF7EE;
  font-size: 56rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  box-shadow: 3rpx 5rpx 0 rgba(34, 29, 21, 0.2);
  animation: sn-stamp-in 520ms cubic-bezier(0.2, 1.4, 0.3, 1) 80ms both;
}
.sn-paper-kicker {
  display: block;
  margin-bottom: 14rpx;
  font-size: 16rpx;
  letter-spacing: 0.35em;
  color: #A79D89;
  font-weight: 700;
}
.sn-paper-title {
  display: block;
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: 44rpx;
  font-weight: 900;
  color: #221D15;
  letter-spacing: 0.08em;
}
.sn-paper-desc {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #6C6353;
}
.sn-paper-line {
  border-top: 2rpx dashed #DFD6C2;
  margin: 30rpx 0 26rpx;
}
.sn-paper-btn {
  height: 84rpx;
  background: #221D15;
  color: #FCF7EE;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  font-family: "Noto Serif SC", "Songti SC", serif;
  letter-spacing: 0.15em;
}
.sn-paper-btn:active { transform: scale(0.97); }

/* ---------- VOLT ---------- */
.sn-volt {
  width: 580rpx;
  max-width: 86vw;
  background: #F2F1ED;
  border: 3rpx solid #111310;
  border-radius: 32rpx;
  padding: 54rpx 40rpx 38rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 8rpx 8rpx 0 #111310;
  animation: sn-slam-in 320ms cubic-bezier(0.2, 1.2, 0.3, 1) both;
}
.sn-volt-kicker {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: #111310;
  color: #D7FF3B;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 0.14em;
  border-radius: 999rpx;
}
.sn-volt-title {
  display: block;
  margin-top: 22rpx;
  font-size: 44rpx;
  font-weight: 900;
  color: #111310;
  letter-spacing: 0.02em;
}
.sn-volt-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #55574F;
}
.sn-volt-btn {
  margin-top: 34rpx;
  height: 88rpx;
  background: #D7FF3B;
  border: 3rpx solid #111310;
  border-radius: 999rpx;
  color: #111310;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sn-volt-btn:active { transform: scale(0.97); }

@keyframes sn-fade-up {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes sn-rise-in {
  from { opacity: 0; transform: translateY(24rpx) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes sn-stamp-in {
  0% { opacity: 0; transform: scale(1.8) rotate(-8deg); }
  60% { opacity: 1; transform: scale(0.94) rotate(-2deg); }
  100% { opacity: 1; transform: scale(1) rotate(0); }
}
@keyframes sn-slam-in {
  0% { opacity: 0; transform: scale(1.12); }
  65% { opacity: 1; transform: scale(0.98); }
  100% { opacity: 1; transform: scale(1); }
}
