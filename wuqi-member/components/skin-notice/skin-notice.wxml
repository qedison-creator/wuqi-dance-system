<view class="sn-root" wx:if="{{props.visible}}">
  <view class="sn-mask sn-mask-{{props.skin || 'classic'}}" catchtouchmove="noop">
    <block wx:if="{{props.skin === 'paper'}}">
      <view class="sn-paper" catchtap="noop">
        <view class="sn-paper-seal">{{props.kind === 'frozen' ? '缓' : '止'}}</view>
        <text class="sn-paper-kicker">MEMBERSHIP NOTICE</text>
        <text class="sn-paper-title">{{props.title}}</text>
        <text class="sn-paper-desc">{{props.desc}}</text>
        <view class="sn-paper-line"></view>
        <view class="sn-paper-btn" catchtap="onOk"><text>{{props.okText || '知道了'}}</text></view>
      </view>
    </block>

    <block wx:elif="{{props.skin === 'volt'}}">
      <view class="sn-volt" catchtap="noop">
        <text class="sn-volt-kicker">{{props.kind === 'frozen' ? 'FROZEN' : 'PAUSED'}}</text>
        <text class="sn-volt-title">{{props.title}}</text>
        <text class="sn-volt-desc">{{props.desc}}</text>
        <view class="sn-volt-btn" catchtap="onOk"><text>{{props.okText || '知道了'}}</text></view>
      </view>
    </block>

    <block wx:else>
      <view class="sn-classic" catchtap="noop">
        <view class="sn-classic-icon">!</view>
        <text class="sn-classic-title">{{props.title}}</text>
        <text class="sn-classic-desc">{{props.desc}}</text>
        <view class="sn-classic-btn" catchtap="onOk"><text>{{props.okText || '知道了'}}</text></view>
      </view>
    </block>
  </view>
</view>
