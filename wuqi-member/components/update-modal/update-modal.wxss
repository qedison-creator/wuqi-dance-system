/* 版本更新提醒弹窗（会员端珊瑚红风格，与预约确认弹窗设计一致） */
.update-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(42, 33, 34, 0.55);
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: updateFadeIn 150ms cubic-bezier(0.4, 0, 0.2, 1);
}

.update-content {
  background: #FFFFFF;
  border-radius: 36rpx;
  width: 86%;
  max-width: 620rpx;
  padding: 48rpx 40rpx 32rpx;
  box-shadow: 0 12rpx 60rpx rgba(42, 33, 34, 0.15);
  animation: updateModalIn 350ms cubic-bezier(0.34, 1.56, 0.64, 1);
  text-align: center;
}

@keyframes updateFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes updateModalIn {
  from {
    opacity: 0;
    transform: scale(0.85);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.update-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #FDF2EF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.update-icon {
  font-size: 48rpx;
  font-weight: 700;
  color: #D4786E;
  line-height: 1;
}

.update-title {
  font-size: 34rpx;
  color: #2A2122;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.update-desc {
  display: block;
  font-size: 28rpx;
  color: #6B5D5E;
  line-height: 1.65;
  white-space: pre-line;
  margin-bottom: 32rpx;
}

.update-actions {
  display: flex;
  justify-content: center;
}

.update-btn {
  width: 320rpx;
  height: 84rpx;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #D4786E, #C05D53);
  box-shadow: 0 6rpx 24rpx rgba(212, 120, 110, 0.3);
  transition: all 150ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.update-btn text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.update-btn:active {
  transform: scale(0.96);
  box-shadow: 0 3rpx 12rpx rgba(212, 120, 110, 0.2);
}

.update-btn.updating {
  opacity: 0.7;
}

.update-later {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
  padding: 8rpx 0;
}

.update-later text {
  font-size: 26rpx;
  color: #B5A5A5;
}
