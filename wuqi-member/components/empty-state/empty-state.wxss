.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(212,120,110,0.08), rgba(232,152,94,0.06));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  animation: float 3s ease-in-out infinite;
}

.empty-icon-inner {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(212,120,110,0.2), rgba(232,152,94,0.15));
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

.empty-text {
  font-size: 30rpx;
  color: #B5A5A5;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #CCC0C0;
  margin-bottom: 30rpx;
}

.empty-action {
  padding: 16rpx 48rpx;
  border: 1rpx solid #D4786E;
  border-radius: 30rpx;
}

.action-text {
  font-size: 26rpx;
  color: #D4786E;
}

/* 皮肤：纸上舞台 / VOLT（组件根挂 skin-root skin-*） */
.empty-state.skin-paper .empty-icon { border-color: #C9BFA8; }
.empty-state.skin-paper .empty-icon-inner { background: #ECE5D6; }
.empty-state.skin-paper .empty-text { font-family: 'Noto Serif SC', serif; }
.empty-state.skin-paper .empty-hint { color: #A79D89; }
.empty-state.skin-paper .empty-action { border: 2rpx solid #221D15; border-radius: 6rpx; }
.empty-state.skin-paper .action-text { color: #221D15; font-family: 'Noto Serif SC', serif; }
.empty-state.skin-volt .empty-icon { border-color: #DCDAD0; }
.empty-state.skin-volt .empty-icon-inner { background: #ECEAE2; }
.empty-state.skin-volt .empty-text { font-weight: 900; color: #111310; }
.empty-state.skin-volt .empty-hint { color: #9C9D93; }
.empty-state.skin-volt .empty-action { background: #111310; border-radius: 999rpx; }
.empty-state.skin-volt .action-text { color: #D7FF3B; font-weight: 800; }
