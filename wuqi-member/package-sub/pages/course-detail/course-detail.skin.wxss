/* 课程详情页皮肤样式（纸上舞台 / VOLT）—— 由 course-detail.wxss 通过 @import 引入 */

/* ---------- 纸上舞台：标题区 ---------- */
.cdp-head { padding: 26rpx 30rpx 0; }
.cdp-kicker {
  font-size: 19rpx; letter-spacing: 0.28em;
  color: var(--sk-hint); font-weight: 700;
}
.cdp-title {
  display: block; margin: 10rpx 0 8rpx;
  font-family: var(--sk-serif);
  font-size: 54rpx; font-weight: 900;
  color: var(--sk-ink); letter-spacing: 0.04em;
  line-height: 1.3;
}
.cdp-coachline { display: flex; align-items: baseline; gap: 12rpx; }
.cdp-coach-k { font-size: 21rpx; color: var(--sk-sub); }
.cdp-coach-n { font-family: var(--sk-serif); font-size: 27rpx; font-weight: 700; color: var(--sk-ink); }
.cdp-coach-more { font-size: 21rpx; color: var(--sk-acc); }
.cdp-rule { margin-top: 20rpx; border-top: 6rpx double #C9BFA8; }

/* ---------- 纸上舞台：信息卡/底栏覆盖 ---------- */
.skin-paper .course-title-card,
.skin-paper .info-card,
.skin-paper .desc-card {
  background: var(--sk-card);
  border: 2rpx solid var(--sk-line);
  border-radius: 8rpx;
  box-shadow: none;
}
.skin-paper .ic-label { color: var(--sk-sub); letter-spacing: 0.1em; }
.skin-paper .ic-value,
.skin-paper .ic-value-highlight { color: var(--sk-ink); }
.skin-paper .ic-value-highlight.gold { color: var(--sk-gold); }
.skin-paper .bb-primary {
  background: var(--sk-acc);
  color: var(--sk-btn-fg);
  border-radius: var(--sk-btn-radius);
  font-family: var(--sk-serif);
  font-weight: 700;
  letter-spacing: 0.1em;
  box-shadow: 2rpx 3rpx 0 rgba(34, 29, 21, 0.18);
}
.skin-paper .bb-primary.state-booked,
.skin-paper .bb-primary.state-done,
.skin-paper .bb-primary.state-ongoing { background: var(--sk-ink); }
.skin-paper .bb-primary.disabled,
.skin-paper .bb-primary.disabled-clickable { background: #ECE5D6; color: var(--sk-hint); box-shadow: none; }
.skin-paper .bb-secondary {
  background: transparent;
  border: 2rpx solid var(--sk-ink);
  color: var(--sk-ink);
  border-radius: var(--sk-btn-radius);
  font-weight: 700;
}

/* ---------- VOLT：标题区 ---------- */
.cdv-head { padding: 26rpx 30rpx 4rpx; position: relative; }
.cdv-kicker {
  font-size: 19rpx; letter-spacing: 0.28em;
  color: var(--sk-sub); font-weight: 700;
}
.cdv-title {
  display: block; margin: 8rpx 0 8rpx;
  font-size: 56rpx; font-weight: 900;
  color: var(--sk-ink); letter-spacing: 0;
  line-height: 1.25;
}
.cdv-coachline { display: flex; align-items: baseline; gap: 12rpx; }
.cdv-coach-k { font-size: 21rpx; color: var(--sk-sub); }
.cdv-coach-n { font-size: 28rpx; font-weight: 900; color: var(--sk-ink); }
.cdv-coach-more { font-size: 21rpx; font-weight: 800; color: var(--sk-ink); }

/* ---------- VOLT：信息卡/底栏覆盖 ---------- */
.skin-volt .course-title-card,
.skin-volt .info-card,
.skin-volt .desc-card {
  background: var(--sk-card);
  border: 3rpx solid var(--sk-ink);
  border-radius: 28rpx;
  box-shadow: 6rpx 6rpx 0 var(--sk-ink);
}
.skin-volt .ic-label { color: var(--sk-sub); font-weight: 700; letter-spacing: 0.12em; }
.skin-volt .ic-value,
.skin-volt .ic-value-highlight { color: var(--sk-ink); font-weight: 700; }
.skin-volt .ic-value-highlight.gold { color: var(--sk-ink); background: var(--sk-volt); padding: 0 10rpx; border-radius: 6rpx; }
.skin-volt .bb-primary {
  background: var(--sk-ink);
  color: var(--sk-acc-fg);
  border-radius: 999rpx;
  font-weight: 800;
  letter-spacing: 0.08em;
  box-shadow: none;
  border: 3rpx solid var(--sk-ink);
}
.skin-volt .bb-primary.state-booked { background: var(--sk-volt); color: var(--sk-ink); }
.skin-volt .bb-primary.state-done { background: var(--sk-card); color: var(--sk-sub); }
.skin-volt .bb-primary.state-ongoing { background: var(--sk-ink); }
.skin-volt .bb-primary.disabled,
.skin-volt .bb-primary.disabled-clickable {
  background: transparent; color: var(--sk-hint);
  border-color: var(--sk-line);
}
.skin-volt .bb-secondary {
  background: transparent;
  border: 3rpx solid var(--sk-ink);
  color: var(--sk-ink);
  border-radius: 999rpx;
  font-weight: 800;
}

/* ---------- 二轮：信息网格（纸底直排、无白底卡） ---------- */
.cdp-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  margin: 10rpx 30rpx 0;
  border-top: 2rpx solid var(--sk-line);
  border-bottom: 2rpx solid var(--sk-line);
}
.cdp-g { padding: 22rpx 8rpx 20rpx 4rpx; border-bottom: 2rpx solid var(--sk-line); }
.cdp-g:nth-child(odd) { border-right: 2rpx solid var(--sk-line); padding-left: 8rpx; }
.cdp-g:nth-child(3), .cdp-g:nth-child(4) { border-bottom: none; }
.cdp-g-k { display: block; font-size: 18rpx; letter-spacing: 0.2em; color: var(--sk-hint); font-weight: 700; }
.cdp-g-v { display: block; margin-top: 8rpx; font-family: var(--sk-serif); font-size: 34rpx; font-weight: 700; color: var(--sk-ink); }
.cdp-g-s { font-size: 21rpx; color: var(--sk-sub); font-weight: 400; font-family: -apple-system, sans-serif; }

/* 约课须知 */
.cdp-note {
  margin: 26rpx 30rpx 0;
  border: 2rpx dashed #C9BFA8;
  border-radius: 4rpx;
  padding: 20rpx 24rpx;
}
.cdp-note-t { display: block; font-family: var(--sk-serif); font-size: 24rpx; font-weight: 700; color: var(--sk-ink); margin-bottom: 8rpx; letter-spacing: 0.1em; }
.cdp-note-b { display: block; font-size: 22rpx; color: var(--sk-sub); line-height: 1.9; }

/* 约课须知下方：消耗 | 我的状态 */
.cdp-grid2 {
  display: grid; grid-template-columns: 1fr 1fr;
  margin: 26rpx 30rpx 0;
  border-bottom: 2rpx solid var(--sk-line);
}
.cdp-g2 { padding: 20rpx 8rpx 24rpx 4rpx; }
.cdp-g2 + .cdp-g2 { border-left: 2rpx solid var(--sk-line); padding-left: 30rpx; }
.cdp-g2-v { display: block; margin-top: 8rpx; font-family: var(--sk-serif); font-size: 34rpx; font-weight: 700; color: var(--sk-ink); }
.cdp-acc { color: var(--sk-acc); }

/* ---------- 二轮：底栏（消耗课时 + 按钮） ---------- */
.skin-paper .bottom-bar {
  display: flex; align-items: center; gap: 26rpx;
  background: var(--sk-card);
  border-top: 2rpx solid var(--sk-line);
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
}
.skin-paper .cd-cost-inline {
  flex-direction: column; align-items: center;
  padding: 0 8rpx 0 6rpx;
  border-right: none; margin-right: 0;
  flex-shrink: 0;
}
.skin-paper .cdc-n { font-size: 52rpx; }
.skin-paper .bb-primary { flex: 1; box-shadow: none; }
.skin-paper .bb-btns { flex: 1; display: flex; gap: 18rpx; }
.skin-paper .bb-secondary, .skin-paper .bb-primary { height: 88rpx; }

/* VOLT 网格（同步无白底） */
.cdv-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  margin: 20rpx 30rpx 0;
  background: var(--sk-card);
  border: 3rpx solid var(--sk-ink);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 6rpx 6rpx 0 var(--sk-ink);
}
.cdv-g { padding: 22rpx 8rpx 20rpx 4rpx; border-bottom: 2rpx dashed var(--sk-line); }
.cdv-g:nth-child(odd) { border-right: 2rpx dashed var(--sk-line); padding-left: 8rpx; }
.cdv-g:nth-child(3), .cdv-g:nth-child(4) { border-bottom: none; }
.cdv-g-k { display: block; font-size: 17rpx; letter-spacing: 0.25em; color: var(--sk-sub); font-weight: 700; }
.cdv-g-v { display: block; margin-top: 8rpx; font-size: 34rpx; font-weight: 700; color: var(--sk-ink); }
.cdv-g-s { font-size: 21rpx; color: var(--sk-sub); font-weight: 500; }
.cdv-grid2 {
  display: grid; grid-template-columns: 1fr 1fr;
  margin: 26rpx 30rpx 0;
  border-bottom: 2rpx solid var(--sk-line);
}
.cdv-g2 { padding: 20rpx 8rpx 24rpx 4rpx; }
.cdv-g2 + .cdv-g2 { border-left: 2rpx dashed var(--sk-line); padding-left: 30rpx; }
.cdv-g2-v { display: block; margin-top: 8rpx; font-size: 34rpx; font-weight: 700; color: var(--sk-ink); }

.skin-volt .bottom-bar {
  display: flex; align-items: center; gap: 26rpx;
  background: var(--sk-card);
  border-top: 3rpx solid var(--sk-ink);
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
}
.skin-volt .cd-cost-inline {
  display: flex; flex-direction: row; align-items: center; gap: 12rpx; flex-wrap: nowrap;
  padding: 0 8rpx 0 6rpx;
  border-right: none; margin-right: 0;
  flex-shrink: 0;
}
.skin-volt .cdc-n { font-size: 52rpx; }
.skin-volt .bb-primary { flex: 1; }
.skin-volt .bb-btns { flex: 1; display: flex; gap: 16rpx; }

/* ---------- 四轮：VOLT 详情补齐预览结构（开抢规则 / COST|STOCK / 底栏库存） ---------- */
.cdv-note {
  margin: 24rpx 30rpx 0;
  border: 2rpx dashed var(--sk-line);
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
}
.cdv-note-t { display: block; font-size: 25rpx; font-weight: 900; color: var(--sk-ink); margin-bottom: 8rpx; letter-spacing: 0.05em; }
.cdv-note-b { display: block; font-size: 22rpx; color: var(--sk-sub); line-height: 1.9; }
.cdv-grid2 {
  display: grid; grid-template-columns: 1fr 1fr;
  margin: 24rpx 30rpx 0;
  background: var(--sk-card);
  border: 3rpx solid var(--sk-ink);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 6rpx 6rpx 0 var(--sk-ink);
}
.cdv-g2 { padding: 22rpx 28rpx; }
.cdv-g2 + .cdv-g2 { border-left: 2rpx dashed var(--sk-line); }
.cdv-cost-v { display: block; margin-top: 6rpx; font-size: 34rpx; font-weight: 700; color: var(--sk-ink); font-family: 'GroteskV', sans-serif; }
.cdv-g-s { font-size: 21rpx; color: var(--sk-sub); font-weight: 500; font-family: -apple-system, sans-serif; }
.cdv-stock-low {
  display: inline-block;
  background: var(--sk-volt); color: var(--sk-ink);
  padding: 0 10rpx; border-radius: 8rpx;
  font-weight: 700;
}
.cdv-stock-low.zero { background: #DCDAD0; color: #77786F; }
/* 底栏：CREDIT 竖排 + 你的库存青柠块 */
.cdc-row { display: flex; align-items: baseline; gap: 8rpx; }
.skin-volt .cdc-n { font-size: 44rpx; font-weight: 700; font-family: 'GroteskV', sans-serif; }
.cdc-l { font-family: 'GroteskV', sans-serif; }
.skin-volt .cdc-l { letter-spacing: 0.04em; }
.cdc-stock {
  margin-top: 0;
  background: var(--sk-volt); color: var(--sk-ink);
  border: none;
  padding: 4rpx 12rpx; border-radius: 8rpx;
  font-size: 20rpx; font-weight: 800;
  white-space: nowrap;
}

/* ---------- 加载态（纸上舞台 / VOLT） ---------- */
.skin-paper .loading-state { background: #F5F1E8; }
.skin-paper .loading-spinner { border: 4rpx solid #DFD6C2; border-top-color: #B93A26; }
.skin-paper .loading-text { color: #A79D89; font-family: 'Noto Serif SC', serif; }
.skin-volt .loading-state { background: #F2F1ED; }
.skin-volt .loading-spinner { border: 4rpx solid #DCDAD0; border-top-color: #111310; }
.skin-volt .loading-text { color: #77786F; font-weight: 700; }
