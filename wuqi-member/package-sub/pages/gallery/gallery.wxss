/* 此间画面 - 画廊页（瀑布流拍立得相册） */
.page {
  min-height: 100vh;
  background: #FBFAF8;
  padding: 48rpx 32rpx 64rpx;
  box-sizing: border-box;
}

/* ===== 标题区（与首页画廊标题风格一致） ===== */
.gallery-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 44rpx;
}

.title-row {
  display: flex;
  align-items: center;
}

.title-line {
  width: 56rpx;
  height: 1px;
  background: rgba(148, 130, 132, 0.5);
}

.title-text {
  font-size: 38rpx;
  color: #2A2122;
  font-weight: 600;
  letter-spacing: 6rpx;
  padding: 0 24rpx;
}

.title-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #948284;
  letter-spacing: 4rpx;
}

/* ===== 瀑布流 ===== */
.masonry {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.masonry-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 拍立得相框：白底 + 内边距 + 多层柔和阴影（与首页画廊相框一致） */
.polaroid {
  background: #FFFFFF;
  border-radius: 8rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(146, 120, 106, 0.10),
              0 1rpx 6rpx rgba(146, 120, 106, 0.06);
  transition: transform 0.2s ease;
}

.polaroid:active {
  transform: scale(0.985);
}

.polaroid-img {
  display: block;
  width: 100%;
  background: #F4F1EE; /* 占位底色，避免加载跳动 */
  border-radius: 4rpx;
}

/* ===== 加载态 ===== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid rgba(212, 120, 110, 0.2);
  border-top-color: #D4786E;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #948284;
  letter-spacing: 2rpx;
}

/* ===== 错误 / 空状态 ===== */
.error-wrap,
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0;
}

.retry-btn {
  margin-top: 32rpx;
  padding: 18rpx 64rpx;
  background: linear-gradient(135deg, #D4786E, #C05D53);
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(198, 93, 83, 0.28);
}

.retry-btn text {
  color: #FFFFFF;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

/* ===== 底部落款 ===== */
.gallery-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 72rpx;
}

.footer-line {
  width: 72rpx;
  height: 1px;
  background: rgba(148, 130, 132, 0.35);
}

.footer-text {
  margin: 20rpx 0;
  font-size: 22rpx;
  color: #948284;
  letter-spacing: 3rpx;
}
