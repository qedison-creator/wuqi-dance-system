<view class="page skin-root skin-{{skinId}}">

  <!-- 标题区：与首页此间画面标题风格一致 -->
  <!-- 经典标题 -->
  <block wx:if="{{skinId === 'classic'}}">
  <view class="gallery-header">
    <view class="title-row">
      <view class="title-line"></view>
      <text class="title-text">此间画面</text>
      <view class="title-line"></view>
    </view>
    <text class="title-sub">舞栖瞬间 · 光影留存</text>
  </view>
  </block>

  <!-- 纸上舞台：影集档案 -->
  <block wx:if="{{skinId === 'paper'}}">
    <view class="gp-head">
      <text class="gp-title">此间画面</text>
      <view class="gp-sub-row">
        <text class="gp-en">MOMENTS ARCHIVE</text>
        <text class="gp-cnt" wx:if="{{colA.length + colB.length > 0}}">共 {{colA.length + colB.length}} 幅</text>
      </view>
      <view class="gp-rule"></view>
      <view class="gp-side">此间画面</view>
    </view>
  </block>

  <!-- VOLT：THE WALL -->
  <block wx:if="{{skinId === 'volt'}}">
    <view class="gv-head">
      <text class="gv-title">画面墙</text>
      <text class="gv-sub" wx:if="{{colA.length + colB.length > 0}}">THE WALL · {{colA.length + colB.length}} SHOTS</text>
    </view>
  </block>

  <!-- 加载态 -->
  <view wx:if="{{loading && !fromCache}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载画面...</text>
  </view>

  <!-- 加载失败 -->
  <view wx:elif="{{loadError && colA.length === 0}}" class="error-wrap">
    <empty-state text="画面加载失败" hint="请检查网络后重试"></empty-state>
    <view class="retry-btn" bindtap="onRetry">
      <text>重新加载</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{!loading && colA.length === 0}}" class="empty-wrap">
    <empty-state text="暂无画面" hint="敬请期待"></empty-state>
  </view>

  <!-- 瀑布流：拍立得相框 -->
  <view wx:else class="masonry">
    <view class="masonry-col">
      <view
        wx:for="{{colA}}"
        wx:key="_id"
        class="polaroid"
        data-url="{{item.image_url}}"
        data-id="{{item._id}}"
        bindtap="onImageTap"
      >
        <image
          class="polaroid-img"
          src="{{item.thumbnail_url || item.image_url}}"
          mode="widthFix"
          lazy-load="{{true}}"
          binderror="onImgError"
          data-id="{{item._id}}"
        />
      </view>
    </view>
    <view class="masonry-col">
      <view
        wx:for="{{colB}}"
        wx:key="_id"
        class="polaroid"
        data-url="{{item.image_url}}"
        data-id="{{item._id}}"
        bindtap="onImageTap"
      >
        <image
          class="polaroid-img"
          src="{{item.thumbnail_url || item.image_url}}"
          mode="widthFix"
          lazy-load="{{true}}"
          binderror="onImgError"
          data-id="{{item._id}}"
        />
      </view>
    </view>
  </view>

  <!-- 底部落款 -->
  <view wx:if="{{colA.length > 0}}" class="gallery-footer">
    <view class="footer-line"></view>
    <text class="footer-text">成人零基础・舞蹈健身服务</text>
    <view class="footer-line"></view>
  </view>

</view>
<update-modal />
