<view class="page skin-root skin-{{skinId}}">
  <block wx:if="{{skinId === 'volt'}}">
    <view class="tbv-bar">
      <view class="tbv-item {{activeTab === 'booking' ? 'on' : ''}}" data-tab="booking" bindtap="onTabChange"><text>预约记录</text></view>
      <view class="tbv-item {{activeTab === 'attendance' ? 'on' : ''}}" data-tab="attendance" bindtap="onTabChange"><text>上课记录</text></view>
      <view class="tbv-item {{activeTab === 'waitlist' ? 'on' : ''}}" data-tab="waitlist" bindtap="onTabChange"><text>排队轮候</text></view>
    </view>
  </block>
  <block wx:else>
  <view class="tab-bar tab-bar-sticky">
    <view class="tb-item {{activeTab === 'booking' ? 'active' : ''}}" data-tab="booking" bindtap="onTabChange">
      <text>预约记录</text>
    </view>
    <view class="tb-item {{activeTab === 'attendance' ? 'active' : ''}}" data-tab="attendance" bindtap="onTabChange">
      <text>上课记录</text>
    </view>
    <view class="tb-item {{activeTab === 'waitlist' ? 'active' : ''}}" data-tab="waitlist" bindtap="onTabChange">
      <text>排队轮候</text>
    </view>
    <view class="tb-slider {{activeTab === 'attendance' ? 'pos1' : (activeTab === 'waitlist' ? 'pos2' : '')}}"></view>
  </view>
  </block>

  <!-- 预约记录页：待上课 + 已完成 + 已取消 合并显示，默认展开5条 -->
  <block wx:if="{{activeTab === 'booking'}}">
      <block wx:if="{{skinId !== 'volt'}}">
    <view class="record-list" wx:if="{{records.length > 0}}">
      <view class="r-card" wx:for="{{records}}" wx:key="_id" wx:if="{{index < bookingVisibleCount}}">
        <view class="rc-left-line {{item.status === 'cancelled' ? 'cancelled' : item.status}}"></view>
        <view class="rc-body">
          <view class="rc-top">
            <text class="rc-name">{{item.courseName || '课程名称'}}</text>
            <block wx:if="{{item.status === 'cancelled'}}">
              <view class="rc-status cancelled">
                <text>{{item.cancelTypeLabel || '已取消'}}</text>
              </view>
            </block>
            <block wx:else>
              <view class="rc-status {{item.status}}">
                <text>{{item.status === 'completed' ? '已完成' : '待上课'}}</text>
              </view>
            </block>
          </view>
          <view class="rc-info">
            <view class="rci-row">
              <view class="rci-icon date"></view>
              <text class="rci-text">{{item.dateStr}} {{item.weekDayStr}}</text>
            </view>
            <view class="rci-row">
              <view class="rci-icon time"></view>
              <text class="rci-text">{{item.startTime}} - {{item.endTime}}</text>
            </view>
            <view class="rci-row" wx:if="{{item.status === 'cancelled' && item.cancelTime}}">
              <view class="rci-icon time"></view>
              <text class="rci-text">取消时间 {{item.cancelTime}}</text>
            </view>
            <view class="rci-row" wx:if="{{item.status === 'completed' && item.checkInMethodText}}">
              <view class="rci-icon checkin"></view>
              <text class="rci-text highlight">{{item.checkInMethodText}}</text>
            </view>
            <view class="rci-row">
              <view class="rci-icon coach"></view>
              <text class="rci-text">{{item.coachName || '教练'}}</text>
            </view>
            <view class="rci-row">
              <view class="rci-icon store"></view>
              <text class="rci-text">{{item.storeName || '门店'}}</text>
            </view>
            <view class="rci-row" wx:if="{{item.status !== 'cancelled' && (item.deductDays || item.creditsCost > 0)}}">
              <view class="rci-icon credit"></view>
              <text class="rci-text highlight">{{item.deductDays ? '有效期减 ' + item.deductDays + ' 天' : '扣除 ' + item.creditsCost + ' 课时'}}{{item.packageLabel ? ' · ' + item.packageLabel : ''}}</text>
            </view>
            <view class="rci-row" wx:if="{{item.status === 'cancelled' && (item.deductDays || item.creditsCost > 0)}}">
              <view class="rci-icon credit"></view>
              <text class="rci-text">{{item.deductDays ? '退还有效期 ' + item.deductDays + ' 天' : '退还 ' + item.creditsCost + ' 课时'}}{{item.packageLabel ? ' · ' + item.packageLabel : ''}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    </block>

    <!-- VOLT：预约记录卡 -->
    <block wx:if="{{skinId === 'volt'}}">
      <view class="rd-volt" wx:for="{{records}}" wx:key="_id" wx:if="{{index < bookingVisibleCount}}">
        <view class="rdv-head">
          <text class="rdv-name">{{item.courseName || '课程名称'}}</text>
          <text class="rdv-badge {{item.status === 'cancelled' ? 'off' : 'on'}}">{{item.status === 'cancelled' ? (item.cancelTypeLabel || '已取消') : (item.status === 'completed' ? '已完成' : '待上课')}}</text>
        </view>
        <view class="rdv-rows">
          <view class="rdv-row"><text class="rdv-k">日期</text><text class="rdv-v">{{item.dateStr}}<text class="rdv-s"> {{item.weekDayStr}}</text></text></view>
          <view class="rdv-row"><text class="rdv-k">时间</text><text class="rdv-v">{{item.startTime}} - {{item.endTime}}</text></view>
          <view class="rdv-row" wx:if="{{item.status === 'cancelled' && item.cancelTime}}"><text class="rdv-k">取消于</text><text class="rdv-v">{{item.cancelTime}}</text></view>
          <view class="rdv-row" wx:if="{{item.status === 'completed' && item.checkInMethodText}}"><text class="rdv-k">签到</text><text class="rdv-v rdv-hl">{{item.checkInMethodText}}</text></view>
          <view class="rdv-row"><text class="rdv-k">教练</text><text class="rdv-v">{{item.coachName || '教练'}}</text></view>
          <view class="rdv-row"><text class="rdv-k">门店</text><text class="rdv-v">{{item.storeName || '门店'}}</text></view>
          <view class="rdv-row" wx:if="{{item.status !== 'cancelled' && (item.deductDays || item.creditsCost > 0)}}"><text class="rdv-k">{{item.deductDays ? '按天' : '扣除'}}</text><text class="rdv-v rdv-hl">{{item.deductDays ? '有效期减 ' + item.deductDays + ' 天' : item.creditsCost + ' 课时'}}{{item.packageLabel ? ' · ' + item.packageLabel : ''}}</text></view>
          <view class="rdv-row" wx:if="{{item.status === 'cancelled' && (item.deductDays || item.creditsCost > 0)}}"><text class="rdv-k">退还</text><text class="rdv-v">{{item.deductDays ? '有效期 ' + item.deductDays + ' 天' : item.creditsCost + ' 课时'}}{{item.packageLabel ? ' · ' + item.packageLabel : ''}}</text></view>
        </view>
      </view>
    </block>

    <!-- 加载更多按钮 -->
    <view class="expand-toggle" wx:if="{{hasMore && activeTab === 'booking'}}" bindtap="onToggleBookingExpand">
      <text>查看更多 ({{total - bookingVisibleCount}}条)</text>
      <view class="toggle-arrow down"></view>
    </view>

    <empty-state
      wx:if="{{!loading && records.length === 0}}"
      text="暂无记录"
      hint="快去预约喜欢的课程吧">
    </empty-state>
  </block>

  <!-- 上课记录页：默认展开5条 -->
  <block wx:if="{{activeTab === 'attendance'}}">
      <block wx:if="{{skinId !== 'volt'}}">
    <view class="record-list" wx:if="{{records.length > 0}}">
      <view class="r-card" wx:for="{{records}}" wx:key="_id" wx:if="{{index < attendanceVisibleCount}}">
        <view class="rc-left-line {{item.isCancelledAfterCheckin ? 'cancelled' : item.status}}"></view>
        <view class="rc-body">
          <view class="rc-top">
            <text class="rc-name">{{item.courseName || '课程名称'}}</text>
            <view class="rc-source method-{{item.checkInMethod || item.source}} {{item.isCancelledAfterCheckin ? 'cancelled-tag' : ''}}">{{item.sourceLabel}}</view>
          </view>
          <view class="rc-info">
            <view class="rci-row">
              <view class="rci-icon date"></view>
              <text class="rci-text">{{item.dateStr}} {{item.weekDayStr}}</text>
            </view>
            <view class="rci-row">
              <view class="rci-icon time"></view>
              <text class="rci-text">{{item.startTime}} - {{item.endTime}}</text>
            </view>
            <view class="rci-row" wx:if="{{item.checkInTime}}">
              <view class="rci-icon checkin"></view>
              <text class="rci-text highlight">签到时间 {{item.checkInTime}}</text>
            </view>
            <view class="rci-row">
              <view class="rci-icon coach"></view>
              <text class="rci-text">{{item.coachName || '教练'}}</text>
            </view>
            <view class="rci-row">
              <view class="rci-icon store"></view>
              <text class="rci-text">{{item.storeName || '门店'}}</text>
            </view>
            <view class="rci-row" wx:if="{{item.isCancelledAfterCheckin}}">
              <view class="rci-icon credit"></view>
              <text class="rci-text">{{item.deductDays ? '退还有效期 ' + item.deductDays + ' 天' : '退还 ' + item.creditsCost + ' 课时'}}{{item.packageLabel ? ' · ' + item.packageLabel : ''}}</text>
            </view>
            <view class="rci-row" wx:if="{{item.isCancelledAfterCheckin && item.cancelReasonText}}">
              <view class="rci-icon time"></view>
              <text class="rci-text">取消原因 {{item.cancelReasonText}}</text>
            </view>
            <view class="rci-row" wx:if="{{!item.isCancelledAfterCheckin && item.deductDays}}">
              <view class="rci-icon credit"></view>
              <text class="rci-text highlight">有效期减 {{item.deductDays}} 天{{item.packageLabel ? ' · ' + item.packageLabel : ''}}</text>
            </view>
            <view class="rci-row" wx:if="{{!item.isCancelledAfterCheckin && !item.deductDays && item.creditsCost > 0}}">
              <view class="rci-icon credit"></view>
              <text class="rci-text highlight">扣除 {{item.creditsCost}} 课时{{item.packageLabel ? ' · ' + item.packageLabel : ''}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    </block>

    <!-- VOLT：上课记录卡 -->
    <block wx:if="{{skinId === 'volt'}}">
      <view class="rd-volt" wx:for="{{records}}" wx:key="_id" wx:if="{{index < attendanceVisibleCount}}">
        <view class="rdv-head">
          <text class="rdv-name">{{item.courseName || '课程名称'}}</text>
          <text class="rdv-badge {{item.isCancelledAfterCheckin ? 'off' : 'on'}}">{{item.isCancelledAfterCheckin ? '课后取消' : (item.sourceLabel || '已上课')}}</text>
        </view>
        <view class="rdv-rows">
          <view class="rdv-row"><text class="rdv-k">日期</text><text class="rdv-v">{{item.dateStr}}<text class="rdv-s"> {{item.weekDayStr}}</text></text></view>
          <view class="rdv-row"><text class="rdv-k">时间</text><text class="rdv-v">{{item.startTime}} - {{item.endTime}}</text></view>
          <view class="rdv-row" wx:if="{{item.checkInTime}}"><text class="rdv-k">签到于</text><text class="rdv-v">{{item.checkInTime}}</text></view>
          <view class="rdv-row"><text class="rdv-k">教练</text><text class="rdv-v">{{item.coachName || '教练'}}</text></view>
          <view class="rdv-row"><text class="rdv-k">门店</text><text class="rdv-v">{{item.storeName || '门店'}}</text></view>
          <view class="rdv-row" wx:if="{{item.isCancelledAfterCheckin}}"><text class="rdv-k">退还</text><text class="rdv-v">{{item.deductDays ? '有效期 ' + item.deductDays + ' 天' : item.creditsCost + ' 课时'}}{{item.packageLabel ? ' · ' + item.packageLabel : ''}}</text></view>
          <view class="rdv-row" wx:elif="{{item.deductDays}}"><text class="rdv-k">按天</text><text class="rdv-v rdv-hl">有效期减 {{item.deductDays}} 天{{item.packageLabel ? ' · ' + item.packageLabel : ''}}</text></view>
          <view class="rdv-row" wx:elif="{{item.creditsCost > 0}}"><text class="rdv-k">扣除</text><text class="rdv-v rdv-hl">{{item.creditsCost}} 课时{{item.packageLabel ? ' · ' + item.packageLabel : ''}}</text></view>
        </view>
      </view>
    </block>

    <!-- 加载更多按钮 -->
    <view class="expand-toggle" wx:if="{{hasMore && activeTab === 'attendance'}}" bindtap="onToggleAttendanceExpand">
      <text>查看更多 ({{total - attendanceVisibleCount}}条)</text>
      <view class="toggle-arrow down"></view>
    </view>

    <empty-state
      wx:if="{{!loading && records.length === 0}}"
      text="暂无上课记录"
      hint="快去预约喜欢的课程吧">
    </empty-state>
  </block>

  <!-- 排队轮候页 -->
  <block wx:if="{{activeTab === 'waitlist'}}">
      <block wx:if="{{skinId !== 'volt'}}">
    <view class="record-list" wx:if="{{records.length > 0}}">
      <view class="r-card" wx:for="{{records}}" wx:key="_id">
        <view class="rc-left-line waitlist"></view>
        <view class="rc-body">
          <view class="rc-top">
            <text class="rc-name">{{item.courseName || '课程名称'}}</text>
            <view class="rc-position-tag">
              <text>排队 {{item.position}}</text>
            </view>
          </view>
          <view class="rc-info">
            <view class="rci-row">
              <view class="rci-icon date"></view>
              <text class="rci-text">{{item.dateStr}} {{item.weekDayStr}}</text>
            </view>
            <view class="rci-row">
              <view class="rci-icon time"></view>
              <text class="rci-text">{{item.startTime}} - {{item.endTime}}</text>
            </view>
            <view class="rci-row">
              <view class="rci-icon coach"></view>
              <text class="rci-text">{{item.coachName || '教练'}}</text>
            </view>
            <view class="rci-row">
              <view class="rci-icon store"></view>
              <text class="rci-text">{{item.storeName || '门店'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    </block>

    <!-- VOLT：排队轮候卡 -->
    <block wx:if="{{skinId === 'volt'}}">
      <view class="rd-volt" wx:for="{{records}}" wx:key="_id">
        <view class="rdv-head">
          <text class="rdv-name">{{item.courseName || '课程名称'}}</text>
          <text class="rdv-badge on">排队 {{item.position}}</text>
        </view>
        <view class="rdv-rows">
          <view class="rdv-row"><text class="rdv-k">日期</text><text class="rdv-v">{{item.dateStr}}<text class="rdv-s"> {{item.weekDayStr}}</text></text></view>
          <view class="rdv-row"><text class="rdv-k">时间</text><text class="rdv-v">{{item.startTime}} - {{item.endTime}}</text></view>
          <view class="rdv-row"><text class="rdv-k">教练</text><text class="rdv-v">{{item.coachName || '教练'}}</text></view>
          <view class="rdv-row"><text class="rdv-k">门店</text><text class="rdv-v">{{item.storeName || '门店'}}</text></view>
        </view>
        <view class="rdv-actions">
          <view class="rdv-cancel" data-id="{{item._id}}" catchtap="onCancelWaitlistTap">取消排队</view>
        </view>
      </view>
    </block>

    <empty-state
      wx:if="{{!loading && records.length === 0}}"
      text="暂无排队轮候">
    </empty-state>
  </block>

  <view class="load-more" wx:if="{{records.length > 0 && !hasMore && activeTab !== 'booking' && activeTab !== 'attendance'}}">
    <view class="lm-line"></view>
    <text>没有更多了</text>
    <view class="lm-line"></view>
  </view>

  <view class="load-more loading" wx:if="{{loading}}">
    <view class="loading-spinner-sm"></view>
    <text>加载中...</text>
  </view>

  <!-- 返回顶部按钮 -->
  <view class="back-to-top {{showBackToTop ? 'show' : ''}}" wx:if="{{showBackToTop}}" bindtap="onBackToTop">
    <text class="btt-icon">↑</text>
  </view>
</view>
<update-modal />
