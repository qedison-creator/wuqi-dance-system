.skin-page {
  min-height: 100vh;
  background: #FBFAF8;
  padding: 30rpx 30rpx 60rpx;
  box-sizing: border-box;
}

.skin-head { margin-bottom: 30rpx; }
.sh-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2A2122;
}
.sh-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #948284;
  line-height: 1.7;
}

.skin-list { display: flex; flex-direction: column; gap: 22rpx; }

.skin-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  background: #FFFFFF;
  border: 3rpx solid #F0E8E5;
  border-radius: 24rpx;
  padding: 28rpx 26rpx;
  transition: all 180ms ease-out;
}
.skin-card.active {
  border-color: #2A2122;
  box-shadow: 5rpx 6rpx 0 rgba(42, 33, 34, 0.85);
}
.skin-card:active { transform: scale(0.97); }

.sc-swatches { display: flex; gap: 8rpx; flex-shrink: 0; }
.sc-sw {
  width: 34rpx;
  height: 34rpx;
  border-radius: 10rpx;
  border: 2rpx solid rgba(42, 33, 34, 0.12);
}

.sc-info { flex: 1; min-width: 0; }
.sc-name { font-size: 30rpx; font-weight: 700; color: #2A2122; }
.sc-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #948284;
  line-height: 1.6;
}

.sc-state {
  font-size: 22rpx;
  color: #B93A26;
  font-weight: 700;
  letter-spacing: 0.08em;
  flex-shrink: 0;
}

.skin-foot {
  margin-top: 36rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B8AFA5;
  line-height: 1.7;
}

@import "./skin-settings.skin.wxss";
